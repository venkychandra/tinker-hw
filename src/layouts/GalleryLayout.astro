---
import '../styles/global.css';
import '../styles/reset.css';
import '../styles/gallery.css';

interface Props {
  title: string;
  description?: string;
  fullscreenHref?: string;
  section?: 'design-system' | 'wireframes' | 'layouts';
}

const { title, description, fullscreenHref, section = 'design-system' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const wireframes = [
  { href: `${base}/wireframes/home`, label: 'Home' },
  { href: `${base}/wireframes/home-visual`, label: 'Home (Visual)' },
  { href: `${base}/wireframes/holiday-listing`, label: 'Holiday Listing' },
  { href: `${base}/wireframes/trip-detail`, label: 'Trip Detail' },
  { href: `${base}/wireframes/destination`, label: 'Destination' },
  { href: `${base}/wireframes/about`, label: 'About' },
  { href: `${base}/wireframes/contact`, label: 'Contact' },
  { href: `${base}/wireframes/faq`, label: 'FAQ' },
];
const pages = [
  { href: `${base}/style-guide`, label: 'Style Guide' },
  { href: `${base}/buttons`, label: 'Buttons' },
  { href: `${base}/icons`, label: 'Icons' },
  { href: `${base}/grid`, label: 'Grid' },
  { href: `${base}/cards`, label: 'Cards' },
  { href: `${base}/forms`, label: 'Forms' },
  { href: `${base}/nav`, label: 'Navigation' },
  { href: `${base}/hero`, label: 'Hero' },
  { href: `${base}/features`, label: 'Features' },
  { href: `${base}/pricing`, label: 'Pricing' },
  { href: `${base}/testimonials`, label: 'Testimonials' },
  { href: `${base}/stats`, label: 'Stats' },
  { href: `${base}/logo-cloud`, label: 'Logo Cloud' },
  { href: `${base}/faq`, label: 'FAQ' },
  { href: `${base}/cta`, label: 'CTA' },
  { href: `${base}/footer`, label: 'Footer' },
];
const layouts = [
  { href: `${base}/home`, label: 'Home' },
  { href: `${base}/home-visual`, label: 'Home (Visual)' },
  { href: `${base}/holiday-listing`, label: 'Holiday Listing' },
  { href: `${base}/trip-detail`, label: 'Trip Detail' },
  { href: `${base}/destination`, label: 'Destination' },
  { href: `${base}/about`, label: 'About' },
  { href: `${base}/contact`, label: 'Contact' },
  { href: `${base}/faq-page`, label: 'FAQ' },
];
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const navItems = section === 'wireframes' ? wireframes
  : section === 'layouts' ? layouts
  : pages;

const sectionLabel = section === 'wireframes' ? 'Wireframes'
  : section === 'layouts' ? 'Layouts'
  : 'Design System';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Design System</title>
  </head>
  <body>
    <div class="gallery-shell">
      <aside class="gallery-sidebar">
        <a href={`${base}/`} class="gallery-sidebar-back">← Gallery</a>
        <div class="gallery-sidebar-title">{sectionLabel}</div>
        <nav class="gallery-nav">
          {navItems.map(({ href, label }) => (
            <a
              href={href}
              aria-current={currentPath === href.replace(/\/$/, '') ? 'page' : undefined}
            >
              {label}
            </a>
          ))}
        </nav>
      </aside>
      <main class="gallery-page">
        <div class="gallery-page-header">
          <h1>{title}</h1>
          {fullscreenHref && <a href={`${base}${fullscreenHref}`} class="gallery-fullscreen-link" target="_blank">View full screen</a>}
        </div>
        {description && <p class="gallery-desc">{description}</p>}
        <slot />
      </main>
    </div>
  </body>
</html>
