---
interface Props {
  variant?: 'simple' | 'standard' | 'newsletter';
  dark?: boolean;
}

const { variant = 'standard', dark = false } = Astro.props;

// --- Color schemes ---
const bg = dark ? 'bg-gray-900' : 'bg-gray-50';
const borderColor = dark ? 'border-gray-700' : 'border-gray-200';
const brandColor = dark ? 'text-white' : 'text-gray-900';
const linkColor = dark
  ? 'text-gray-300 hover:text-white'
  : 'text-gray-600 hover:text-gray-900';
const headingColor = dark ? 'text-white' : 'text-gray-900';
const copyrightColor = dark ? 'text-gray-400' : 'text-gray-500';
const inputBg = dark ? 'bg-gray-800 border-gray-700' : 'bg-white border-gray-300';
const inputText = dark ? 'text-white placeholder:text-gray-400' : 'text-gray-900 placeholder:text-gray-500';
const inputFocus = dark
  ? 'focus:border-primary-400 focus:ring-primary-400/20'
  : 'focus:border-primary-500 focus:ring-primary-500/20';

const linkBase = 'text-sm transition-colors duration-fast ease-default focus-visible:outline-2 focus-visible:outline-primary-300 focus-visible:outline-offset-2';
const socialBase = 'inline-flex items-center justify-center w-10 h-10 rounded-md transition-colors duration-fast ease-default focus-visible:outline-2 focus-visible:outline-primary-300 focus-visible:outline-offset-2';
const socialLink = dark
  ? `${socialBase} text-gray-300 hover:text-white hover:bg-gray-800`
  : `${socialBase} text-gray-600 hover:text-gray-900 hover:bg-gray-100`;
---

{variant === 'simple' && (
  <footer class={`@container ${bg} border-t ${borderColor}`}>
    <div class="max-w-[var(--container-max)] mx-auto px-6 py-8">
      <div class="flex flex-col @sm:flex-row items-center justify-between gap-4">
        <!-- Copyright -->
        <p class={`text-sm ${copyrightColor}`}>
          © {new Date().getFullYear()} Headwater Holidays. All rights reserved.
        </p>

        <!-- Links -->
        <nav class="flex flex-wrap items-center justify-center gap-6">
          <a href="/privacy-notice" class={`${linkBase} ${linkColor}`}>Privacy Notice</a>
          <a href="/terms-conditions" class={`${linkBase} ${linkColor}`}>Terms & Conditions</a>
          <a href="/contact" class={`${linkBase} ${linkColor}`}>Contact us</a>
        </nav>
      </div>
    </div>
  </footer>
)}

{variant === 'standard' && (
