---
interface Props {
  name: string;
  price: string;
  unit?: string;
  description?: string;
  features: string[];
  featured?: boolean;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  name,
  price,
  unit = 'per person',
  description,
  features,
  featured = false,
  ctaLabel = 'Choose This Trip',
  ctaHref = '#',
} = Astro.props;

// --- Card container ---
const cardBase = 'rounded-lg overflow-hidden flex flex-col';
const cardStyle = featured
  ? `${cardBase} bg-white shadow-lg border border-gray-200 border-t-4 border-t-accent-500`
  : `${cardBase} bg-white shadow-sm border border-gray-200`;

// --- CTA button (matches Button md pattern as <a>) ---
const ctaBase = 'inline-flex items-center justify-center gap-2 font-semibold cursor-pointer text-base px-6 py-3 rounded-md transition-colors duration-fast ease-default active:translate-y-px focus-visible:outline-2 focus-visible:outline-primary-300 focus-visible:outline-offset-2 w-full text-center';
const ctaStyle = featured
  ? `${ctaBase} bg-primary-500 text-white hover:bg-primary-600 active:bg-primary-700`
  : `${ctaBase} bg-transparent text-gray-900 shadow-[inset_0_0_0_1px_var(--color-gray-200)] hover:bg-gray-50 active:bg-gray-100`;
---

<div class={cardStyle}>
  <div class="p-6 @md:p-8 flex flex-col grow">
    {/* Badge */}
    {featured && (
      <span class="inline-block self-start text-xs font-semibold uppercase tracking-wide bg-accent-50 text-accent-600 px-3 py-1 rounded-sm mb-4">
        Most Popular
      </span>
    )}

    {/* Name */}
    <h3 class="text-xl font-bold text-gray-900">{name}</h3>

    {/* Price */}
    <div class="mt-3 flex items-baseline gap-2">
      <span class="text-4xl font-bold tracking-tight text-gray-900">{price}</span>
      <span class="text-sm text-gray-500">{unit}</span>
    </div>

    {/* Description */}
    {description && (
      <p class="text-base text-gray-600 mt-4 max-w-[45ch]">{description}</p>
    )}

    {/* Feature list */}
    <ul class="mt-6 flex flex-col gap-3 grow">
      {features.map((feature) => (
        <li class="flex items-start gap-3 text-sm text-gray-700">
          <svg class="w-4 h-4 mt-0.5 text-primary-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12" />
          </svg>
          {feature}
        </li>
      ))}
    </ul>

    {/* CTA */}
    <div class="mt-8">
      <a href={ctaHref} class={ctaStyle}>{ctaLabel}</a>
    </div>
  </div>
</div>
