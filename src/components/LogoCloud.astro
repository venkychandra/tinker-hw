---
interface Logo {
  src: string;
  alt: string;
  href?: string;
}

interface Props {
  heading?: string;
  eyebrow?: string;
  logos: Logo[];
}

const { heading, eyebrow, logos } = Astro.props;
---

<section class="@container py-16 px-6">
  <div class="max-w-[var(--container-max)] mx-auto">
    {(eyebrow || heading) && (
      <div class="text-center mb-12">
        {eyebrow && (
          <p data-role="eyebrow" class="text-sm font-semibold text-accent-600 uppercase tracking-wide mb-2">
            {eyebrow}
          </p>
        )}
        {heading && (
          <h2 class="text-2xl font-semibold text-gray-700">
            {heading}
          </h2>
        )}
      </div>
    )}

    <div class="grid grid-cols-2 @sm:grid-cols-3 @md:grid-cols-4 @lg:grid-cols-6 gap-8 items-center justify-items-center">
      {logos.map((logo) => (
        logo.href ? (
          <a
            href={logo.href}
            class="group flex items-center justify-center w-full h-20 grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-[var(--duration-normal)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary-500 rounded-sm"
          >
            <img
              src={logo.src}
              alt={logo.alt}
              class="max-w-full max-h-full object-contain"
            />
          </a>
        ) : (
          <div class="flex items-center justify-center w-full h-20 grayscale opacity-50">
            <img
              src={logo.src}
              alt={logo.alt}
              class="max-w-full max-h-full object-contain"
            />
          </div>
        )
      ))}
    </div>
  </div>
</section>
