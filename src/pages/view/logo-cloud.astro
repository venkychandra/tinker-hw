---

<FullScreenLayout title="Logo Cloud">
  <div class="@container min-h-screen bg-white">
    <!-- Hero Section -->
    <section class="py-20 px-6 text-center bg-gray-50" data-seamless>
      <div class="max-w-3xl mx-auto">
        <h1 class="text-6xl font-bold text-gray-900 leading-tight mb-4">
          Trusted expertise since 1992
        </h1>
        <p class="text-xl text-gray-600 max-w-[65ch] mx-auto">
          Award-winning adventure travel experiences, backed by industry-leading certifications and recognized by the world's most trusted publications.
        </p>
      </div>
    </section>

    <!-- Certifications -->
    <LogoCloud
      eyebrow="Protected & Certified"
      heading="Industry-leading memberships and certifications"
      logos={certifications}
    />

    <!-- Divider -->
    <div class="border-t border-gray-200 my-16 max-w-[var(--container-max)] mx-auto"></div>

    <!-- Media Mentions -->
    <LogoCloud
      eyebrow="As featured in"
      heading="Recognized by the world's leading travel publications"
      logos={mediaLogos}
    />

    <!-- CTA Section -->
    <section class="py-20 px-6 text-center bg-primary-50 mt-20" data-seamless>
      <div class="max-w-2xl mx-auto">
        <h2 class="text-4xl font-bold text-gray-900 leading-tight mb-4">
          Ready to start your adventure?
        </h2>
        <p class="text-lg text-gray-600 mb-8">
          Browse our collection of expertly crafted walking and cycling tours across Europe.
        </p>
        <a
          href="/tours"
          class="inline-flex items-center gap-2 px-6 py-3 bg-primary-500 text-white font-semibold rounded-md shadow-sm hover:bg-primary-600 active:bg-primary-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500 transition-colors duration-[var(--duration-normal)]"
        >
          Browse Tours
        </a>
      </div>
    </section>
  </div>
</FullScreenLayout>
