---
import FullScreenLayout from '../../layouts/FullScreenLayout.astro';
import Nav from '../../components/Nav.astro';
import Hero from '../../components/Hero.astro';
import Button from '../../components/Button.astro';
import TextInput from '../../components/TextInput.astro';
import Textarea from '../../components/Textarea.astro';
import Select from '../../components/Select.astro';
import Checkbox from '../../components/Checkbox.astro';
import Footer from '../../components/Footer.astro';
import Phone from '../../components/icons/Phone.astro';
import Mail from '../../components/icons/Mail.astro';
import Shield from '../../components/icons/Shield.astro';
import Star from '../../components/icons/Star.astro';
---

<FullScreenLayout title="Contact">
  <div class="@container page-flow">

    <!-- Navigation -->
    <Nav />

    <!-- Hero -->
    <Hero
      variant="simple"
      heading="Get in Touch"
      subheading="Our team of travel experts is here to help plan your perfect active holiday"
    />

    <!-- Contact Methods -->
    <section class="@container">
      <div class="max-w-[var(--container-max)] mx-auto px-6">
        <div class="grid grid-cols-1 @md:grid-cols-3 gap-6">

          <!-- Phone -->
          <div class="bg-primary-50 border border-primary-200 rounded-lg p-8 text-center space-y-4">
            <div class="bg-primary-100 rounded-full w-16 h-16 mx-auto flex items-center justify-center text-primary-600">
              <Phone size={32} />
            </div>
            <div class="space-y-3">
              <h3 class="text-lg font-semibold text-gray-800">Call Us</h3>
              <a href="tel:01606720199" class="block text-2xl font-bold text-primary-700 hover:text-primary-800 transition-colors duration-fast ease-default">
                01606 720199
              </a>
              <p class="text-sm text-gray-600 leading-relaxed">
                Mon-Fri: 9am-7pm<br />
                Sat: 9am-5pm<br />
                Sun: Closed
              </p>
            </div>
          </div>

          <!-- Email -->
          <div class="bg-primary-50 border border-primary-200 rounded-lg p-8 text-center space-y-4">
            <div class="bg-primary-100 rounded-full w-16 h-16 mx-auto flex items-center justify-center text-primary-600">
              <Mail size={32} />
            </div>
            <div class="space-y-3">
              <h3 class="text-lg font-semibold text-gray-800">Email Us</h3>
              <a href="mailto:sales@headwater.com" class="block text-base font-semibold text-primary-700 hover:text-primary-800 transition-colors duration-fast ease-default">
                sales@headwater.com
              </a>
              <p class="text-sm text-gray-600">We aim to respond within 24 hours</p>
            </div>
          </div>

          <!-- Brochure -->
          <div class="bg-primary-50 border border-primary-200 rounded-lg p-8 text-center space-y-4">
            <div class="bg-primary-100 rounded-full w-16 h-16 mx-auto flex items-center justify-center text-2xl text-primary-600">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
              </svg>
            </div>
            <div class="space-y-3">
              <h3 class="text-lg font-semibold text-gray-800">Request Brochure</h3>
              <p class="text-sm text-gray-600">Get our full catalog delivered to your door</p>
              <a href="/request-brochure" class="inline-flex items-center justify-center gap-2 font-semibold cursor-pointer text-sm px-4 py-2 rounded-md bg-primary-500 text-white hover:bg-primary-600 active:bg-primary-700 active:translate-y-px focus-visible:outline-2 focus-visible:outline-primary-300 focus-visible:outline-offset-2 transition-colors duration-fast ease-default">
                Request Now
              </a>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Main Content: Form + Sidebar -->
    <section class="@container">
      <div class="max-w-[var(--container-max)] mx-auto px-6">
        <div class="grid grid-cols-1 @lg:grid-cols-[2fr_1fr] gap-12">

          <!-- Contact Form -->
          <div class="space-y-6">
            <div class="space-y-2">
              <h2 class="text-3xl font-bold text-gray-800">Send us a message</h2>
              <p class="text-base text-gray-600">Fill out the form below and we'll get back to you as soon as possible</p>
            </div>

            <form class="space-y-6">

              <!-- Name Fields -->
              <div class="grid grid-cols-1 @md:grid-cols-2 gap-4">
                <TextInput label="First Name *" placeholder="John" />
                <TextInput label="Last Name *" placeholder="Smith" />
              </div>

              <!-- Email & Phone -->
              <div class="grid grid-cols-1 @md:grid-cols-2 gap-4">
                <TextInput label="Email Address *" placeholder="john@example.com" />
                <TextInput label="Phone Number" placeholder="07123 456789" />
              </div>

              <!-- Subject -->
              <Select
                label="Subject *"
                placeholder="Select a topic"
                options={[
                  'General Enquiry',
                  'Holiday Information',
                  'Booking Question',
                  'Feedback',
                  'Other'
                ]}
              />

              <!-- Message -->
              <Textarea
                label="Message *"
                placeholder="Tell us how we can help..."
                rows={6}
              />

              <!-- Newsletter Opt-in -->
              <div class="space-y-3">
                <Checkbox
                  label="Yes, I'd like to receive holiday inspiration, travel tips, and exclusive offers by email"
                />
              </div>

              <!-- Submit Button -->
              <Button size="lg" variant="primary">
                Send Message
              </Button>

              <p class="text-xs text-gray-500">
                * Required fields. By submitting this form, you agree to our <a href="/privacy-notice" class="text-primary-600 underline hover:text-primary-700 transition-colors duration-fast">Privacy Notice</a>
              </p>

            </form>
          </div>

          <!-- Sidebar Info -->
          <aside class="space-y-6">

            <!-- Office Hours -->
            <div class="bg-gray-50 border border-gray-200 rounded-lg p-6 space-y-4">
              <h3 class="text-lg font-semibold text-gray-800">Office Hours</h3>
              <div class="space-y-3 text-sm text-gray-700">
                <div class="flex justify-between">
                  <span>Monday - Friday</span>
                  <span class="font-semibold">9am - 7pm</span>
                </div>
                <div class="flex justify-between">
                  <span>Saturday</span>
                  <span class="font-semibold">9am - 5pm</span>
                </div>
                <div class="flex justify-between">
                  <span>Sunday</span>
                  <span class="font-semibold">Closed</span>
                </div>
                <div class="flex justify-between pt-3 border-t border-gray-300">
                  <span>Bank Holidays</span>
                  <span class="font-semibold">Closed</span>
                </div>
              </div>
              <div class="bg-primary-50 border border-primary-200 rounded-md p-4">
                <p class="text-sm text-primary-800 font-semibold flex items-center gap-2">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 16 14" />
                  </svg>
                  We're open now until 7pm
                </p>
              </div>
            </div>

            <!-- Office Location -->
            <div class="bg-gray-50 border border-gray-200 rounded-lg p-6 space-y-4">
              <h3 class="text-lg font-semibold text-gray-800">Visit Us</h3>
              <div class="space-y-2 text-sm text-gray-700">
                <p class="font-semibold">Headwater Holidays</p>
                <p class="leading-relaxed">
                  The Old School House<br />
                  Chester Road<br />
                  Northwich, Cheshire<br />
                  CW8 1LE<br />
                  United Kingdom
                </p>
              </div>
              <div class="bg-gray-200 border border-gray-300 rounded-md h-40 flex items-center justify-center text-gray-500 text-sm">
                [ Map placeholder ]
              </div>
            </div>

            <!-- Quick Links -->
            <div class="bg-gray-50 border border-gray-200 rounded-lg p-6 space-y-4">
              <h3 class="text-lg font-semibold text-gray-800">Quick Links</h3>
              <nav class="space-y-2">
                <a href="/request-brochure" class="block text-sm text-primary-600 hover:text-primary-700 hover:underline transition-colors duration-fast">Request a Brochure</a>
                <a href="/faq" class="block text-sm text-primary-600 hover:text-primary-700 hover:underline transition-colors duration-fast">Frequently Asked Questions</a>
                <a href="/travel-insurance" class="block text-sm text-primary-600 hover:text-primary-700 hover:underline transition-colors duration-fast">Travel Insurance</a>
                <a href="/booking-conditions" class="block text-sm text-primary-600 hover:text-primary-700 hover:underline transition-colors duration-fast">Booking Conditions</a>
              </nav>
            </div>

          </aside>

        </div>
      </div>
    </section>

    <!-- Common Questions -->
    <section class="@container">
      <div class="max-w-[var(--container-max)] mx-auto px-6 space-y-8">

        <div class="text-center space-y-2">
          <h2 class="text-3xl font-bold text-gray-800">Common Questions</h2>
          <p class="text-base text-gray-600">Quick answers to frequently asked questions</p>
        </div>

        <div class="grid grid-cols-1 @md:grid-cols-2 gap-6">

          <!-- FAQ 1 -->
          <div class="bg-gray-50 border border-gray-200 rounded-lg p-6 space-y-3">
            <h3 class="text-base font-semibold text-gray-800">How do I book a holiday?</h3>
            <p class="text-sm text-gray-600 leading-relaxed">
              You can book online, call us on 01606 720199, or request a callback. Our team will guide you through the process and answer any questions.
            </p>
            <a href="/how-to-book" class="inline-flex items-center gap-1 text-sm text-primary-600 font-semibold hover:text-primary-700 transition-colors duration-fast">
              Learn more
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </svg>
            </a>
          </div>

          <!-- FAQ 2 -->
          <div class="bg-gray-50 border border-gray-200 rounded-lg p-6 space-y-3">
            <h3 class="text-base font-semibold text-gray-800">What's included in the price?</h3>
            <p class="text-sm text-gray-600 leading-relaxed">
              All our holidays include accommodation, daily breakfast, luggage transfers, route notes, GPS navigation, and 24/7 support.
            </p>
            <a href="/whats-included" class="inline-flex items-center gap-1 text-sm text-primary-600 font-semibold hover:text-primary-700 transition-colors duration-fast">
              View full details
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </svg>
            </a>
          </div>

          <!-- FAQ 3 -->
          <div class="bg-gray-50 border border-gray-200 rounded-lg p-6 space-y-3">
            <h3 class="text-base font-semibold text-gray-800">Can you tailor-make a holiday?</h3>
            <p class="text-sm text-gray-600 leading-relaxed">
              Yes! We specialize in customizing holidays to suit your preferences, fitness level, and schedule. Contact us to discuss your requirements.
            </p>
            <a href="/tailor-made" class="inline-flex items-center gap-1 text-sm text-primary-600 font-semibold hover:text-primary-700 transition-colors duration-fast">
              Get in touch
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </svg>
            </a>
          </div>

          <!-- FAQ 4 -->
          <div class="bg-gray-50 border border-gray-200 rounded-lg p-6 space-y-3">
            <h3 class="text-base font-semibold text-gray-800">Is my booking protected?</h3>
            <p class="text-sm text-gray-600 leading-relaxed">
              Yes. All our holidays are ABTA and ATOL protected, giving you complete financial protection and peace of mind.
            </p>
            <a href="/financial-protection" class="inline-flex items-center gap-1 text-sm text-primary-600 font-semibold hover:text-primary-700 transition-colors duration-fast">
              About protection
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </svg>
            </a>
          </div>

        </div>

        <div class="text-center pt-4">
          <a href="/faq" class="inline-flex items-center gap-1 text-base text-primary-600 font-semibold hover:text-primary-700 transition-colors duration-fast">
            View All FAQs
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="12 5 19 12 12 19" />
            </svg>
          </a>
        </div>

      </div>
    </section>

    <!-- Social Media -->
    <section class="@container">
      <div class="max-w-[var(--container-max)] mx-auto px-6">
        <div class="bg-gray-50 border border-gray-200 rounded-lg p-12 text-center space-y-6">
          <h2 class="text-3xl font-bold text-gray-800">Follow Our Journey</h2>
          <p class="text-base text-gray-600">Get travel inspiration and updates on our social channels</p>

          <div class="flex gap-4 justify-center flex-wrap">
            <a href="https://facebook.com" aria-label="Facebook" class="inline-flex items-center justify-center w-14 h-14 rounded-lg bg-gray-100 border border-gray-300 text-gray-600 hover:bg-gray-200 hover:text-gray-900 transition-colors duration-fast focus-visible:outline-2 focus-visible:outline-primary-300 focus-visible:outline-offset-2">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M9.198 21.5h4v-8.01h3.604l.396-3.98h-4V7.5a1 1 0 0 1 1-1h3v-4h-3a5 5 0 0 0-5 5v2.01h-2l-.396 3.98h2.396v8.01Z" />
              </svg>
            </a>
            <a href="https://instagram.com" aria-label="Instagram" class="inline-flex items-center justify-center w-14 h-14 rounded-lg bg-gray-100 border border-gray-300 text-gray-600 hover:bg-gray-200 hover:text-gray-900 transition-colors duration-fast focus-visible:outline-2 focus-visible:outline-primary-300 focus-visible:outline-offset-2">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
              </svg>
            </a>
            <a href="https://twitter.com" aria-label="X (Twitter)" class="inline-flex items-center justify-center w-14 h-14 rounded-lg bg-gray-100 border border-gray-300 text-gray-600 hover:bg-gray-200 hover:text-gray-900 transition-colors duration-fast focus-visible:outline-2 focus-visible:outline-primary-300 focus-visible:outline-offset-2">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M22.46 6c-.85.38-1.78.64-2.75.76a4.8 4.8 0 0 0 2.1-2.66c-.92.55-1.95.95-3.03 1.16A4.75 4.75 0 0 0 11.32 9.3a13.47 13.47 0 0 1-9.78-4.96a4.75 4.75 0 0 0 1.47 6.34c-.77-.02-1.5-.23-2.13-.58v.06a4.75 4.75 0 0 0 3.8 4.65c-.7.19-1.44.23-2.15.08a4.75 4.75 0 0 0 4.43 3.3A9.53 9.53 0 0 1 2 19.54a13.44 13.44 0 0 0 7.29 2.14c8.75 0 13.54-7.25 13.54-13.54 0-.21 0-.41-.01-.61A9.65 9.65 0 0 0 22.46 6z" />
              </svg>
            </a>
            <a href="https://youtube.com" aria-label="YouTube" class="inline-flex items-center justify-center w-14 h-14 rounded-lg bg-gray-100 border border-gray-300 text-gray-600 hover:bg-gray-200 hover:text-gray-900 transition-colors duration-fast focus-visible:outline-2 focus-visible:outline-primary-300 focus-visible:outline-offset-2">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
              </svg>
            </a>
            <a href="https://pinterest.com" aria-label="Pinterest" class="inline-flex items-center justify-center w-14 h-14 rounded-lg bg-gray-100 border border-gray-300 text-gray-600 hover:bg-gray-200 hover:text-gray-900 transition-colors duration-fast focus-visible:outline-2 focus-visible:outline-primary-300 focus-visible:outline-offset-2">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Trust Signals -->
    <section class="@container">
      <div class="max-w-[var(--container-max)] mx-auto px-6">
        <div class="bg-primary-50 border border-primary-200 rounded-lg p-12">
          <div class="grid grid-cols-1 @md:grid-cols-3 gap-8">

            <div class="text-center space-y-3">
              <div class="flex items-center justify-center gap-3">
                <div class="text-primary-600">
                  <Shield size={32} />
                </div>
                <p class="text-lg font-semibold text-gray-800">ABTA & ATOL Protected</p>
              </div>
              <p class="text-sm text-gray-600">Complete financial protection for your peace of mind</p>
            </div>

            <div class="text-center space-y-3">
              <div class="flex items-center justify-center gap-3">
                <div class="text-accent-500">
                  <Star size={32} />
                </div>
                <p class="text-lg font-semibold text-gray-800">40+ Years Experience</p>
              </div>
              <p class="text-sm text-gray-600">Trusted by thousands of travelers since 1985</p>
            </div>

            <div class="text-center space-y-3">
              <div class="flex items-center justify-center gap-3">
                <span class="text-3xl">💚</span>
                <p class="text-lg font-semibold text-gray-800">B-Corp Certified</p>
              </div>
              <p class="text-sm text-gray-600">Committed to sustainable and responsible travel</p>
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <Footer variant="standard" />

  </div>
</FullScreenLayout>
