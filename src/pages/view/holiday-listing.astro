---
import FullScreenLayout from '../../layouts/FullScreenLayout.astro';
import Nav from '../../components/Nav.astro';
import Card from '../../components/Card.astro';
import Button from '../../components/Button.astro';
import Checkbox from '../../components/Checkbox.astro';
import CTA from '../../components/CTA.astro';
import Footer from '../../components/Footer.astro';

// Sample holiday data
const holidays = [
  {
    title: 'Tuscany Walking',
    location: 'Italy',
    type: 'Self-Guided',
    rating: 4.8,
    description: 'Discover rolling hills, medieval villages, and world-class wine regions on this iconic Tuscan trail.',
    duration: '7 days',
    level: 'Moderate',
    price: '£1,245',
    featured: true,
    image: 'https://placehold.co/400x192/4a7c59/f5f5f0?text=Tuscany+Walking',
    imageAlt: 'Rolling hills and vineyards of Tuscany with cypress trees',
  },
  {
    title: 'Camino de Santiago',
    location: 'Spain',
    type: 'Self-Guided',
    rating: 4.9,
    description: 'Walk the ancient pilgrimage route through northern Spain, staying in authentic hotels along the way.',
    duration: '8 days',
    level: 'Moderate',
    price: '£995',
    featured: false,
    image: 'https://placehold.co/400x192/5a8d68/f5f5f0?text=Camino+de+Santiago',
    imageAlt: 'Ancient pilgrimage path through Spanish countryside',
  },
  {
    title: 'Dolomites Trek',
    location: 'Italy',
    type: 'Self-Guided',
    rating: 4.7,
    description: 'Mountain walking through dramatic alpine scenery, with comfortable hotels and spectacular views.',
    duration: '6 days',
    level: 'Challenging',
    price: '£1,495',
    featured: false,
    image: 'https://placehold.co/400x192/3d6a50/f5f5f0?text=Dolomites+Trek',
    imageAlt: 'Dramatic mountain peaks and valleys of the Dolomites',
  },
  {
    title: 'Cotswolds Way',
    location: 'UK',
    type: 'Self-Guided',
    rating: 4.6,
    description: 'Gentle walks through quintessential English countryside, historic villages, and rolling meadows.',
    duration: '5 days',
    level: 'Easy',
    price: '£795',
    featured: false,
    image: 'https://placehold.co/400x192/5a8d68/f5f5f0?text=Cotswolds+Way',
    imageAlt: 'Rolling green hills and honey-stone villages of the Cotswolds',
  },
  {
    title: 'Portuguese Coast',
    location: 'Portugal',
    type: 'Self-Guided',
    rating: 4.8,
    description: 'Walk along stunning coastal paths and traditional villages, with fresh seafood and ocean views.',
    duration: '7 days',
    level: 'Moderate',
    price: '£1,095',
    featured: false,
    image: 'https://placehold.co/400x192/4a7c59/f5f5f0?text=Portuguese+Coast',
    imageAlt: 'Coastal cliffs and traditional fishing villages along Portuguese coast',
  },
  {
    title: 'Swiss Alps Trail',
    location: 'Switzerland',
    type: 'Self-Guided',
    rating: 4.9,
    description: 'Breathtaking mountain scenery and alpine villages, staying in traditional Swiss hotels.',
    duration: '8 days',
    level: 'Challenging',
    price: '£1,795',
    featured: false,
    image: 'https://placehold.co/400x192/3d6a50/f5f5f0?text=Swiss+Alps+Trail',
    imageAlt: 'Alpine meadows and snow-capped peaks in the Swiss Alps',
  },
];
---

<FullScreenLayout title="Walking Holidays">
  <div class="@container page-flow" style="--section-gap: 0">
    <!-- Navigation -->
    <Nav variant="light" />

    <!-- Main Content -->
    <section class="@container bg-white">
      <div class="max-w-[var(--container-max)] mx-auto px-6 py-8">
        <!-- Breadcrumbs -->
        <nav class="text-sm text-gray-500 mb-6" aria-label="Breadcrumb">
          <ol class="flex items-center gap-2">
            <li><a href="/" class="hover:text-gray-900 transition-colors focus-visible:outline-2 focus-visible:outline-primary-300 focus-visible:outline-offset-2 rounded-sm">Home</a></li>
            <li aria-hidden="true">›</li>
            <li class="text-gray-900 font-medium" aria-current="page">Walking Holidays</li>
          </ol>
        </nav>

        <!-- Page Header -->
        <header class="mb-12">
          <h1 class="text-5xl font-bold text-gray-900 text-wrap-balance mb-4">Walking Holidays</h1>
          <p class="text-lg text-gray-600 max-w-[65ch] text-wrap-pretty">
            Self-guided walking adventures across Europe and beyond. Hand-picked hotels, award-winning routes, and authentic local experiences.
          </p>
        </header>

        <!-- Filters & Results Layout -->
        <div class="grid grid-cols-1 @lg:grid-cols-[280px_1fr] gap-8">

          <!-- Sidebar Filters -->
          <aside class="space-y-6">
            <!-- Filters Panel -->
            <Card variant="default">
              <div class="space-y-6">
                <h2 class="text-base font-semibold text-gray-900">Filter Results</h2>

                <!-- Destination Filter -->
                <div class="space-y-3 pb-6 border-b border-gray-200">
                  <h3 class="text-sm font-semibold text-gray-900">Destination</h3>
                  <div class="space-y-2">
                    <Checkbox size="sm" label="France (24)" />
                    <Checkbox size="sm" label="Italy (18)" checked />
                    <Checkbox size="sm" label="Spain (16)" />
                    <Checkbox size="sm" label="UK (12)" />
                    <button class="text-sm text-primary-600 hover:text-primary-700 font-medium transition-colors focus-visible:outline-2 focus-visible:outline-primary-300 focus-visible:outline-offset-2 rounded-sm">
                      + Show more
                    </button>
                  </div>
                </div>

                <!-- Activity Level Filter -->
                <div class="space-y-3 pb-6 border-b border-gray-200">
                  <h3 class="text-sm font-semibold text-gray-900">Activity Level</h3>
                  <div class="space-y-2">
                    <Checkbox size="sm" label="Easy (8)" />
                    <Checkbox size="sm" label="Moderate (32)" />
                    <Checkbox size="sm" label="Challenging (14)" />
                  </div>
                </div>

                <!-- Duration Filter -->
                <div class="space-y-3 pb-6 border-b border-gray-200">
                  <h3 class="text-sm font-semibold text-gray-900">Duration</h3>
                  <div class="space-y-2">
                    <Checkbox size="sm" label="3-5 days (6)" />
                    <Checkbox size="sm" label="6-8 days (28)" />
                    <Checkbox size="sm" label="9+ days (20)" />
                  </div>
                </div>

                <!-- Price Range -->
                <div class="space-y-3 pb-6 border-b border-gray-200">
                  <h3 class="text-sm font-semibold text-gray-900">Price Range</h3>
                  <div class="space-y-3">
                    <div class="relative h-2 bg-gray-200 rounded-full">
                      <div class="absolute h-2 bg-primary-500 rounded-full w-2/3 left-0"></div>
                    </div>
                    <div class="flex justify-between text-sm text-gray-600">
                      <span>£500</span>
                      <span>£2500</span>
                    </div>
                  </div>
                </div>

                <!-- Clear Filters -->
                <Button variant="secondary" size="sm">
                  Clear All Filters
                </Button>
              </div>
            </Card>

            <!-- Popular Routes Promo -->
            <Card variant="flat">
              <div class="space-y-3">
                <h3 class="text-sm font-semibold text-gray-900">Popular Routes</h3>
                <p class="text-sm text-gray-600">
                  Camino de Santiago, Tuscany, Lake District
                </p>
                <a href="/popular-routes" class="text-sm text-primary-600 hover:text-primary-700 font-medium transition-colors focus-visible:outline-2 focus-visible:outline-primary-300 focus-visible:outline-offset-2 rounded-sm">
                  View all →
                </a>
              </div>
            </Card>
          </aside>

          <!-- Main Content -->
          <main class="space-y-6">
            <!-- Results Header -->
            <div class="flex flex-col @sm:flex-row justify-between items-start @sm:items-center gap-4 pb-6 border-b border-gray-200">
              <p class="text-base text-gray-600">
                Showing <span class="font-semibold text-gray-900">54 holidays</span>
              </p>
              <div class="flex items-center gap-3">
                <label for="sort" class="text-sm text-gray-600">Sort by:</label>
                <select
                  id="sort"
                  class="text-sm px-3 py-2 border border-gray-300 rounded-md bg-white text-gray-900 hover:border-gray-400 focus:border-primary-500 focus:outline-2 focus:outline-primary-300 focus:outline-offset-0 transition-colors"
                >
                  <option>Recommended</option>
                  <option>Price: Low to High</option>
                  <option>Price: High to Low</option>
                  <option>Duration: Short to Long</option>
                  <option>Rating: High to Low</option>
                </select>
              </div>
            </div>

            <!-- Holiday Cards Grid -->
            <div class="grid grid-cols-1 @md:grid-cols-2 @2xl:grid-cols-3 gap-6">
              {holidays.map((holiday) => (
                <Card variant="default" padding={false}>
                  <article class="h-full flex flex-col">
                    <!-- Image -->
                    <div class="relative h-48 overflow-hidden">
                      <img
                        src={holiday.image}
                        alt={holiday.imageAlt}
                        class="w-full h-full object-cover"
                      />
                      {holiday.featured && (
                        <span class="absolute top-3 right-3 bg-accent-500 text-white px-3 py-1 rounded-sm text-xs font-semibold shadow-md">
                          Featured
                        </span>
                      )}
                    </div>

                    <!-- Content -->
                    <div class="p-6 flex flex-col flex-1 gap-4">
                      <!-- Title & Rating -->
                      <div class="flex items-start justify-between gap-3">
                        <div>
                          <h3 class="text-lg font-semibold text-gray-900 text-wrap-balance">
                            {holiday.title}
                          </h3>
                          <p class="text-sm text-gray-600 mt-1">
                            {holiday.location} · {holiday.type}
                          </p>
                        </div>
                        <div class="flex items-center gap-1 text-sm shrink-0">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="text-accent-500">
                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                          </svg>
                          <span class="font-semibold text-gray-900">{holiday.rating}</span>
                        </div>
                      </div>

                      <!-- Description -->
                      <p class="text-sm text-gray-600 line-clamp-2 text-wrap-pretty">
                        {holiday.description}
                      </p>

                      <!-- Details & Price -->
                      <div class="flex items-center justify-between pt-4 mt-auto border-t border-gray-200">
                        <div class="text-sm text-gray-600">
                          <span class="font-semibold text-gray-900">{holiday.duration}</span> · {holiday.level}
                        </div>
                        <div class="text-right">
                          <p class="text-xs text-gray-500">from</p>
                          <p class="text-xl font-bold text-gray-900">{holiday.price}</p>
                        </div>
                      </div>

                      <!-- CTA Button -->
                      <Button variant="primary" size="sm">
                        View Holiday
                      </Button>
                    </div>
                  </article>
                </Card>
              ))}
            </div>

            <!-- Pagination -->
            <nav class="flex justify-center items-center gap-2 pt-6" aria-label="Pagination">
              <Button variant="secondary" size="sm" disabled>
                Previous
              </Button>
              <Button variant="primary" size="sm">1</Button>
              <Button variant="ghost" size="sm">2</Button>
              <Button variant="ghost" size="sm">3</Button>
              <Button variant="ghost" size="sm">4</Button>
              <span class="text-sm text-gray-500 px-2">...</span>
              <Button variant="ghost" size="sm">12</Button>
              <Button variant="secondary" size="sm">
                Next
              </Button>
            </nav>
          </main>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <CTA
      variant="simple"
      heading="Can't find what you're looking for?"
      subheading="Our expert team can help you plan the perfect walking holiday tailored to your interests and experience level."
      primaryCta="Contact Us"
      primaryHref="/contact"
      secondaryCta="Request Brochure"
      secondaryHref="/request-brochure"
    />

    <!-- Footer -->
    <Footer variant="standard" />
  </div>
</FullScreenLayout>
