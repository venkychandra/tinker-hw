---
import GalleryLayout from '../layouts/GalleryLayout.astro';
import PricingTable from '../components/PricingTable.astro';
import PricingCard from '../components/PricingCard.astro';
---

<GalleryLayout title="Pricing" description="Pricing table with trip package tiers. PricingTable wraps PricingCards in a responsive grid. Featured tier gets terracotta accent border, elevated shadow, and primary CTA." fullscreenHref="/view/pricing">

  <!-- Default — 3 tiers -->
  <section class="specimen-section">
    <h2>Default — Three Tiers</h2>
    <p class="text-sm text-gray-600 mb-6 max-w-[65ch]">
      Trip packages using domain vocabulary. The featured tier (<code class="text-xs bg-gray-100 px-1.5 py-0.5 rounded-sm font-mono">featured</code> prop) gets a terracotta top border, elevated shadow, "Most Popular" badge, and primary CTA. Other tiers use secondary CTA.
    </p>
    <div class="border border-gray-200 rounded-lg overflow-hidden">
      <PricingTable
        eyebrow="Choose Your Adventure"
        heading="Holiday Packages"
        subheading="Three levels of comfort and support. Every package includes route notes, GPS navigation, and 24/7 local support."
      >
        <PricingCard
          name="Trail"
          price="£895"
          description="The essentials for independent walkers. You handle the pace; we handle the rest."
          features={[
            'Handpicked B&Bs and guesthouses',
            'Detailed route notes and maps',
            'GPS tracks for your phone',
            'Luggage transfers between stops',
            '24/7 local support line',
          ]}
          ctaLabel="Choose Trail"
        />
        <PricingCard
          name="Summit"
          price="£1,295"
          featured
          description="Our most popular package. Better hotels, more flexibility, and a few extras that make the difference."
          features={[
            'Boutique hotels and character inns',
            'Detailed route notes and maps',
            'GPS tracks for your phone',
            'Luggage transfers between stops',
            '24/7 local support line',
            'Welcome dinner at a local restaurant',
            'Flexible rest day built into itinerary',
          ]}
          ctaLabel="Choose Summit"
        />
        <PricingCard
          name="Ridge"
          price="£1,795"
          description="The premium experience. Top-tier hotels, private transfers, and every detail taken care of."
          features={[
            'Luxury hotels and historic properties',
            'Detailed route notes and maps',
            'GPS tracks for your phone',
            'Private airport transfers',
            'Dedicated trip coordinator',
            'Welcome and farewell dinners',
            'Flexible rest days',
            'Upgrade to e-bike (cycling trips)',
          ]}
          ctaLabel="Choose Ridge"
        />
      </PricingTable>
    </div>
  </section>

  <!-- Featured card detail -->
  <section class="specimen-section">
    <h2>Featured vs Default Card</h2>
    <p class="text-sm text-gray-600 mb-6 max-w-[65ch]">
      Side-by-side comparison of featured and default card treatment. Featured gets: accent-500 top border (4px), shadow-lg (vs shadow-sm), "Most Popular" badge in accent-50, and primary CTA button.
    </p>
    <div class="border border-gray-200 rounded-lg overflow-hidden p-8">
      <div class="@container">
        <div class="grid grid-cols-1 @md:grid-cols-2 gap-6 max-w-2xl mx-auto">
          <PricingCard
            name="Trail"
            price="£895"
            description="Standard treatment."
            features={[
              'B&Bs and guesthouses',
              'Route notes and maps',
              'Luggage transfers',
            ]}
            ctaLabel="Secondary CTA"
          />
          <PricingCard
            name="Summit"
            price="£1,295"
            featured
            description="Featured treatment."
            features={[
              'Boutique hotels',
              'Route notes and maps',
              'Luggage transfers',
              'Welcome dinner',
            ]}
            ctaLabel="Primary CTA"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Per couple pricing -->
  <section class="specimen-section">
    <h2>Alternate Unit</h2>
    <p class="text-sm text-gray-600 mb-6 max-w-[65ch]">
      The <code class="text-xs bg-gray-100 px-1.5 py-0.5 rounded-sm font-mono">unit</code> prop changes the price suffix. Default is "per person" — can be "per couple", "per night", etc.
    </p>
    <div class="border border-gray-200 rounded-lg overflow-hidden p-8">
      <div class="@container">
        <div class="max-w-sm mx-auto">
          <PricingCard
            name="Summit for Two"
            price="£2,390"
            unit="per couple"
            featured
            description="Book together and save. Same Summit experience, better value."
            features={[
              'Boutique hotels — double room',
              'Route notes and maps for two',
              'Two sets of luggage transferred',
              'Welcome dinner for two',
            ]}
            ctaLabel="Book for Two"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Dark background -->
  <section class="specimen-section">
    <h2>Dark Background</h2>
    <p class="text-sm text-gray-600 mb-6 max-w-[65ch]">
      The <code class="text-xs bg-gray-100 px-1.5 py-0.5 rounded-sm font-mono">dark</code> prop on PricingTable inverts the section background. Cards remain white — they pop against the dark surface.
    </p>
    <div class="border border-gray-200 rounded-lg overflow-hidden">
      <PricingTable
        dark
        eyebrow="Pricing"
        heading="Find Your Level"
        subheading="All packages include the essentials. Choose the comfort level that suits you."
      >
        <PricingCard
          name="Trail"
          price="£895"
          features={[
            'Guesthouses and B&Bs',
            'Route notes and maps',
            'Luggage transfers',
            'Local support line',
          ]}
          ctaLabel="Choose Trail"
        />
        <PricingCard
          name="Summit"
          price="£1,295"
          featured
          features={[
            'Boutique hotels',
            'Route notes and maps',
            'Luggage transfers',
            'Local support line',
            'Welcome dinner',
            'Rest day included',
          ]}
          ctaLabel="Choose Summit"
        />
        <PricingCard
          name="Ridge"
          price="£1,795"
          features={[
            'Luxury hotels',
            'Route notes and maps',
            'Private transfers',
            'Dedicated coordinator',
            'Two dinners included',
            'E-bike upgrade',
          ]}
          ctaLabel="Choose Ridge"
        />
      </PricingTable>
    </div>
  </section>

  <!-- Responsive behavior -->
  <section class="specimen-section">
    <h2>Responsive Behavior</h2>
    <p class="text-sm text-gray-600 mb-6 max-w-[65ch]">
      Cards stack single-column at narrow, 2-column at <code class="text-xs bg-gray-100 px-1.5 py-0.5 rounded-sm font-mono">@md:</code> (768px), and 3-column at <code class="text-xs bg-gray-100 px-1.5 py-0.5 rounded-sm font-mono">@lg:</code> (1024px). Card padding tightens from p-8 to p-6 via <code class="text-xs bg-gray-100 px-1.5 py-0.5 rounded-sm font-mono">@md:</code>.
    </p>

    <h3 class="text-sm font-semibold text-gray-600 uppercase tracking-wide mb-4">Narrow (~320px)</h3>
    <div class="border border-gray-200 rounded-lg overflow-hidden mb-6">
      <div style="max-width: 320px; margin: 0 auto;">
        <PricingTable heading="Packages">
          <PricingCard
            name="Trail"
            price="£895"
            features={['Guesthouses', 'Route notes', 'Luggage transfers']}
          />
          <PricingCard
            name="Summit"
            price="£1,295"
            featured
            features={['Boutique hotels', 'Route notes', 'Luggage transfers', 'Welcome dinner']}
          />
        </PricingTable>
      </div>
    </div>

    <h3 class="text-sm font-semibold text-gray-600 uppercase tracking-wide mb-4">Medium (~768px)</h3>
    <div class="border border-gray-200 rounded-lg overflow-hidden">
      <div style="max-width: 768px; margin: 0 auto;">
        <PricingTable heading="Packages">
          <PricingCard
            name="Trail"
            price="£895"
            features={['Guesthouses', 'Route notes', 'Luggage transfers']}
          />
          <PricingCard
            name="Summit"
            price="£1,295"
            featured
            features={['Boutique hotels', 'Route notes', 'Luggage transfers', 'Welcome dinner']}
          />
          <PricingCard
            name="Ridge"
            price="£1,795"
            features={['Luxury hotels', 'Route notes', 'Private transfers', 'Coordinator']}
          />
        </PricingTable>
      </div>
    </div>
  </section>

  <!-- Anatomy -->
  <section class="specimen-section">
    <h2>Anatomy</h2>
    <p class="text-sm text-gray-600 mb-6 max-w-[65ch]">
      Props and class construction breakdown.
    </p>
    <div class="border border-gray-200 rounded-lg overflow-hidden">
      <div class="p-6">
        <div class="flex flex-col gap-3 text-sm">
          <div class="flex gap-3 items-start">
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide w-24 shrink-0 pt-0.5">Table grid</span>
            <code class="text-xs bg-gray-100 px-2 py-1 rounded-sm font-mono text-gray-700 leading-relaxed">grid-cols-1 @md:grid-cols-2 @lg:grid-cols-3 gap-6 @lg:gap-8</code>
          </div>
          <div class="flex gap-3 items-start">
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide w-24 shrink-0 pt-0.5">Card default</span>
            <code class="text-xs bg-gray-100 px-2 py-1 rounded-sm font-mono text-gray-700 leading-relaxed">bg-white border border-gray-200 rounded-lg shadow-sm</code>
          </div>
          <div class="flex gap-3 items-start">
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide w-24 shrink-0 pt-0.5">Card featured</span>
            <code class="text-xs bg-gray-100 px-2 py-1 rounded-sm font-mono text-gray-700 leading-relaxed">shadow-lg, border-t-4 border-t-accent-500 (trail marker)</code>
          </div>
          <div class="flex gap-3 items-start">
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide w-24 shrink-0 pt-0.5">Badge</span>
            <code class="text-xs bg-gray-100 px-2 py-1 rounded-sm font-mono text-gray-700 leading-relaxed">text-xs uppercase bg-accent-50 text-accent-600 — featured only</code>
          </div>
          <div class="flex gap-3 items-start">
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide w-24 shrink-0 pt-0.5">Price</span>
            <code class="text-xs bg-gray-100 px-2 py-1 rounded-sm font-mono text-gray-700 leading-relaxed">text-4xl font-bold tracking-tight + text-sm unit suffix</code>
          </div>
          <div class="flex gap-3 items-start">
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide w-24 shrink-0 pt-0.5">Features</span>
            <code class="text-xs bg-gray-100 px-2 py-1 rounded-sm font-mono text-gray-700 leading-relaxed">ul with check icons — primary-500 stroke, text-sm text-gray-700</code>
          </div>
          <div class="flex gap-3 items-start">
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide w-24 shrink-0 pt-0.5">CTA featured</span>
            <code class="text-xs bg-gray-100 px-2 py-1 rounded-sm font-mono text-gray-700 leading-relaxed">Button md primary — bg-primary-500, full width</code>
          </div>
          <div class="flex gap-3 items-start">
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide w-24 shrink-0 pt-0.5">CTA default</span>
            <code class="text-xs bg-gray-100 px-2 py-1 rounded-sm font-mono text-gray-700 leading-relaxed">Button md secondary — inset border, full width</code>
          </div>
          <div class="flex gap-3 items-start">
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide w-24 shrink-0 pt-0.5">Card padding</span>
            <code class="text-xs bg-gray-100 px-2 py-1 rounded-sm font-mono text-gray-700 leading-relaxed">p-6 @md:p-8 — tightens at narrow containers</code>
          </div>
        </div>
      </div>
    </div>
  </section>

</GalleryLayout>
