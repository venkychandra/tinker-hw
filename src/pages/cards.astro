---
import GalleryLayout from '../layouts/GalleryLayout.astro';
import Card from '../components/Card.astro';
import ArrowRight from '../components/icons/ArrowRight.astro';
import MapPin from '../components/icons/MapPin.astro';
import Star from '../components/icons/Star.astro';
import Walking from '../components/icons/Walking.astro';
import Cycling from '../components/icons/Cycling.astro';
import Mountain from '../components/icons/Mountain.astro';
import Calendar from '../components/icons/Calendar.astro';
---

<GalleryLayout title="Cards" description="Three visual treatments for containing content. Default for most uses, elevated for featured trips and interactive selections, flat for grouped activity details or low-emphasis containers." fullscreenHref="/view/cards">

  <!-- Variants -->
  <section class="specimen-section">
    <h2>Variants</h2>
    <p class="text-sm text-gray-600 mb-6 max-w-[65ch]">
      <code class="text-xs bg-gray-100 px-1.5 py-0.5 rounded-sm font-mono">default</code> uses a 1px border + subtle shadow.
      <code class="text-xs bg-gray-100 px-1.5 py-0.5 rounded-sm font-mono">elevated</code> drops the border and relies on a larger shadow that grows on hover.
      <code class="text-xs bg-gray-100 px-1.5 py-0.5 rounded-sm font-mono">flat</code> uses a tinted background with no border or shadow.
    </p>
    <div class="border border-gray-200 rounded-lg p-8">
      <div class="grid grid-cols-3 gap-6">
        <div class="flex flex-col gap-3">
          <Card>
            <p class="font-semibold text-gray-900 mb-1">Default</p>
            <p class="text-sm text-gray-600">Versatile container for trip listings, destination details, and content sections.</p>
          </Card>
          <span class="text-xs font-mono text-gray-400 text-center">default</span>
        </div>
        <div class="flex flex-col gap-3">
          <Card variant="elevated">
            <p class="font-semibold text-gray-900 mb-1">Elevated</p>
            <p class="text-sm text-gray-600">For featured trips and interactive selections — lifts on hover.</p>
          </Card>
          <span class="text-xs font-mono text-gray-400 text-center">elevated</span>
        </div>
        <div class="flex flex-col gap-3">
          <Card variant="flat">
            <p class="font-semibold text-gray-900 mb-1">Flat</p>
            <p class="text-sm text-gray-600">For grouped information, activity details, or low-emphasis containers.</p>
          </Card>
          <span class="text-xs font-mono text-gray-400 text-center">flat</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Content Card (Trip Card) -->
  <section class="specimen-section">
    <h2>Trip Card</h2>
    <p class="text-sm text-gray-600 mb-6 max-w-[65ch]">
      Image top with <code class="text-xs bg-gray-100 px-1.5 py-0.5 rounded-sm font-mono">padding=false</code> on the card, then a padded body below. The image uses <code class="text-xs bg-gray-100 px-1.5 py-0.5 rounded-sm font-mono">object-fit: cover</code> in a fixed-height container. Good for trip listings, destination highlights, and itinerary previews.
    </p>
    <div class="border border-gray-200 rounded-lg p-8">
      <div class="grid grid-cols-3 gap-6">
        <Card padding={false}>
          <div class="h-48 bg-gray-200"></div>
          <div class="p-6">
            <span class="inline-block text-xs font-semibold text-accent-600 bg-accent-100 px-2 py-0.5 rounded-full mb-3">Walking</span>
            <p class="font-semibold text-gray-900 mb-1">Provence Lavender Trail</p>
            <p class="text-xs text-gray-500 mb-3">7 nights · Guided · France</p>
            <p class="text-sm text-gray-600 mb-4">Wander through purple lavender fields and hilltop villages in the heart of Provence, with picnic lunches and vineyard visits along the way.</p>
            <a class="text-sm font-semibold text-accent-600 inline-flex items-center gap-1 hover:text-accent-700 transition-colors duration-fast ease-default" href="#">View trip <ArrowRight size={14} /></a>
          </div>
        </Card>
        <Card padding={false}>
          <div class="h-48 bg-gray-200"></div>
          <div class="p-6">
            <span class="inline-block text-xs font-semibold text-accent-600 bg-accent-100 px-2 py-0.5 rounded-full mb-3">Cycling</span>
            <p class="font-semibold text-gray-900 mb-1">Tuscan Hill Towns</p>
            <p class="text-xs text-gray-500 mb-3">10 nights · Self-guided · Italy</p>
            <p class="text-sm text-gray-600 mb-4">Ride between medieval hilltop towns, through olive groves and past cypress-lined roads, stopping for long lunches and local wines.</p>
            <a class="text-sm font-semibold text-accent-600 inline-flex items-center gap-1 hover:text-accent-700 transition-colors duration-fast ease-default" href="#">View trip <ArrowRight size={14} /></a>
          </div>
        </Card>
        <Card padding={false}>
          <div class="h-48 bg-gray-200"></div>
          <div class="p-6">
            <span class="inline-block text-xs font-semibold text-accent-600 bg-accent-100 px-2 py-0.5 rounded-full mb-3">Walking</span>
            <p class="font-semibold text-gray-900 mb-1">Amalfi Coast Path</p>
            <p class="text-xs text-gray-500 mb-3">8 nights · Guided · Italy</p>
            <p class="text-sm text-gray-600 mb-4">Follow ancient pathways high above the Mediterranean, descending to clifftop villages for fresh seafood and limoncello at sunset.</p>
            <a class="text-sm font-semibold text-accent-600 inline-flex items-center gap-1 hover:text-accent-700 transition-colors duration-fast ease-default" href="#">View trip <ArrowRight size={14} /></a>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <!-- Feature Card -->
  <section class="specimen-section">
    <h2>Feature Card</h2>
    <p class="text-sm text-gray-600 mb-6 max-w-[65ch]">
      Icon or illustration at top, then title and description. No image, no CTA link — the card itself is the content. Works well in 3- or 4-column grids for feature and benefit sections.
    </p>
    <div class="border border-gray-200 rounded-lg p-8">
      <div class="grid grid-cols-3 gap-6">
        <Card variant="flat">
          <div class="w-10 h-10 rounded-lg bg-accent-100 text-accent-600 flex items-center justify-center mb-4">
            <MapPin size={20} />
          </div>
          <p class="font-semibold text-gray-900 mb-1">Handpicked routes</p>
          <p class="text-sm text-gray-600">Every trail is walked and verified by our team before we add it.</p>
        </Card>
        <Card variant="flat">
          <div class="w-10 h-10 rounded-lg bg-accent-100 text-accent-600 flex items-center justify-center mb-4">
            <Star size={20} />
          </div>
          <p class="font-semibold text-gray-900 mb-1">Quality accommodation</p>
          <p class="text-sm text-gray-600">Characterful hotels and guesthouses, never generic chains.</p>
        </Card>
        <Card variant="flat">
          <div class="w-10 h-10 rounded-lg bg-accent-100 text-accent-600 flex items-center justify-center mb-4">
            <Walking size={20} />
          </div>
          <p class="font-semibold text-gray-900 mb-1">Luggage transfers</p>
          <p class="text-sm text-gray-600">Your bags move ahead while you walk. Arrive to find everything waiting.</p>
        </Card>
      </div>
    </div>
  </section>

  <!-- Pricing Card -->
  <section class="specimen-section">
    <h2>Pricing Card</h2>
    <p class="text-sm text-gray-600 mb-6 max-w-[65ch]">
      Elevated cards for trip tier selection. The popular tier uses an accent badge and primary button to draw the eye. Others use secondary styling.
    </p>
    <div class="border border-gray-200 rounded-lg p-8">
      <div class="grid grid-cols-3 gap-6">
        <!-- Comfort -->
        <Card variant="elevated">
          <p class="font-semibold text-gray-900 mb-1">Comfort</p>
          <p class="text-sm text-gray-500 mb-4">Everything you need for a wonderful trip</p>
          <p class="text-3xl font-bold text-gray-900 mb-1">from £1,295<span class="text-sm font-normal text-gray-500">pp</span></p>
          <hr class="my-4 border-gray-200" />
          <ul class="space-y-2 text-sm text-gray-600 mb-6">
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-accent-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12" /></svg>
              Quality 3-star hotels
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-accent-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12" /></svg>
              Half-board meals
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-accent-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12" /></svg>
              Standard luggage transfer
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-accent-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12" /></svg>
              Regional maps pack
            </li>
          </ul>
          <button class="w-full rounded-md border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50 transition-colors duration-fast ease-default cursor-pointer">Book this tier</button>
        </Card>

        <!-- Superior (Popular) -->
        <Card variant="elevated">
          <div class="flex items-center justify-between mb-1">
            <p class="font-semibold text-gray-900">Superior</p>
            <span class="text-xs font-semibold text-accent-600 bg-accent-100 px-2 py-0.5 rounded-full">POPULAR</span>
          </div>
          <p class="text-sm text-gray-500 mb-4">Our most popular tier for good reason</p>
          <p class="text-3xl font-bold text-gray-900 mb-1">from £1,695<span class="text-sm font-normal text-gray-500">pp</span></p>
          <hr class="my-4 border-gray-200" />
          <ul class="space-y-2 text-sm text-gray-600 mb-6">
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-accent-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12" /></svg>
              4-star boutique hotels
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-accent-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12" /></svg>
              Full-board with wine
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-accent-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12" /></svg>
              Express luggage transfer
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-accent-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12" /></svg>
              GPS route files
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-accent-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12" /></svg>
              Welcome hamper
            </li>
          </ul>
          <button class="w-full rounded-md bg-primary-500 px-4 py-2 text-sm font-semibold text-white hover:bg-primary-600 transition-colors duration-fast ease-default cursor-pointer">Book this tier</button>
        </Card>

        <!-- Premier -->
        <Card variant="elevated">
          <p class="font-semibold text-gray-900 mb-1">Premier</p>
          <p class="text-sm text-gray-500 mb-4">The finest adventure travel experience</p>
          <p class="text-3xl font-bold text-gray-900 mb-1">from £2,295<span class="text-sm font-normal text-gray-500">pp</span></p>
          <hr class="my-4 border-gray-200" />
          <ul class="space-y-2 text-sm text-gray-600 mb-6">
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-accent-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12" /></svg>
              5-star luxury accommodation
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-accent-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12" /></svg>
              All meals with wine pairing
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-accent-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12" /></svg>
              Private luggage transfer
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-accent-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12" /></svg>
              Personal route consultation
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-accent-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12" /></svg>
              Airport transfers
            </li>
          </ul>
          <button class="w-full rounded-md border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50 transition-colors duration-fast ease-default cursor-pointer">Book this tier</button>
        </Card>
      </div>
    </div>
  </section>

  <!-- Testimonial -->
  <section class="specimen-section">
    <h2>Testimonial</h2>
    <p class="text-sm text-gray-600 mb-6 max-w-[65ch]">
      A flat card composed with avatar, quote, and attribution — a common pairing for social proof sections.
    </p>
    <div class="border border-gray-200 rounded-lg p-8">
      <div class="max-w-lg">
        <Card variant="flat">
          <div class="flex gap-4">
            <div class="w-10 h-10 rounded-full bg-gray-300 shrink-0"></div>
            <div>
              <p class="text-sm text-gray-900 mb-2">"The Provence trail was the holiday of a lifetime. Every detail was thought of — the routes, the hotels, the luggage transfers. We just walked and enjoyed."</p>
              <p class="text-xs font-semibold text-gray-900">Margaret & David Thompson</p>
              <p class="text-xs text-gray-400">Provence Lavender Trail, June 2024</p>
            </div>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <!-- Anatomy -->
  <section class="specimen-section">
    <h2>Anatomy</h2>
    <p class="text-sm text-gray-600 mb-6 max-w-[65ch]">
      Class breakdown per variant. The component accepts <code class="text-xs bg-gray-100 px-1.5 py-0.5 rounded-sm font-mono">variant</code> and <code class="text-xs bg-gray-100 px-1.5 py-0.5 rounded-sm font-mono">padding</code> props.
    </p>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-gray-200">
            <th class="text-left py-3 pr-6 font-semibold text-gray-900">Variant</th>
            <th class="text-left py-3 pr-6 font-semibold text-gray-900">Classes</th>
            <th class="text-left py-3 font-semibold text-gray-900">Use case</th>
          </tr>
        </thead>
        <tbody class="text-gray-600">
          <tr class="border-b border-gray-100">
            <td class="py-3 pr-6 font-mono text-xs">default</td>
            <td class="py-3 pr-6 font-mono text-xs">rounded-lg p-6 bg-white border border-gray-200 shadow-sm</td>
            <td class="py-3">Trip listings, destination details, general containers</td>
          </tr>
          <tr class="border-b border-gray-100">
            <td class="py-3 pr-6 font-mono text-xs">elevated</td>
            <td class="py-3 pr-6 font-mono text-xs">rounded-lg p-6 bg-white shadow-lg hover:shadow-xl transition-shadow</td>
            <td class="py-3">Featured trips, pricing tiers, selectable options</td>
          </tr>
          <tr>
            <td class="py-3 pr-6 font-mono text-xs">flat</td>
            <td class="py-3 pr-6 font-mono text-xs">rounded-lg p-6 bg-gray-50</td>
            <td class="py-3">Activity details, grouped content, low-emphasis containers</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

</GalleryLayout>
