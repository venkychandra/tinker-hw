---
import GalleryLayout from '../layouts/GalleryLayout.astro';
import ArrowRight from '../components/icons/ArrowRight.astro';
import ChevronDown from '../components/icons/ChevronDown.astro';
import Close from '../components/icons/Close.astro';
import Menu from '../components/icons/Menu.astro';
import Search from '../components/icons/Search.astro';
import MapPin from '../components/icons/MapPin.astro';
import Calendar from '../components/icons/Calendar.astro';
import Phone from '../components/icons/Phone.astro';
import Mail from '../components/icons/Mail.astro';
import Star from '../components/icons/Star.astro';
import Walking from '../components/icons/Walking.astro';
import Cycling from '../components/icons/Cycling.astro';
import Mountain from '../components/icons/Mountain.astro';
---

<GalleryLayout title="Icons" description="Inline SVG icons using currentColor. Each icon is an Astro component with a size prop, plus a downloadable SVG in public/icons/.">

  <!-- Icon Gallery -->
  <section class="specimen-section">
    <h2>Gallery</h2>
    <p class="text-sm text-gray-600 mb-6 max-w-[65ch]">
      Each icon renders as inline SVG with <code class="text-xs bg-gray-100 px-1.5 py-0.5 rounded-sm font-mono">stroke="currentColor"</code>, so it inherits the parent's text color. Default size is <code class="text-xs bg-gray-100 px-1.5 py-0.5 rounded-sm font-mono">24px</code>.
    </p>
    <div class="border border-gray-200 rounded-lg p-8">
      <div class="grid grid-cols-4 gap-6" style="max-width: 600px;">
        <div class="flex flex-col items-center gap-2">
          <div class="w-12 h-12 flex items-center justify-center bg-gray-50 rounded-lg">
            <ArrowRight />
          </div>
          <p class="text-xs font-medium text-gray-900">ArrowRight</p>
          <a href="/icons/arrow-right.svg" download class="text-[11px] text-primary-500 hover:text-primary-600">Download SVG</a>
        </div>
        <div class="flex flex-col items-center gap-2">
          <div class="w-12 h-12 flex items-center justify-center bg-gray-50 rounded-lg">
            <ChevronDown />
          </div>
          <p class="text-xs font-medium text-gray-900">ChevronDown</p>
          <a href="/icons/chevron-down.svg" download class="text-[11px] text-primary-500 hover:text-primary-600">Download SVG</a>
        </div>
        <div class="flex flex-col items-center gap-2">
          <div class="w-12 h-12 flex items-center justify-center bg-gray-50 rounded-lg">
            <Close />
          </div>
          <p class="text-xs font-medium text-gray-900">Close</p>
          <a href="/icons/close.svg" download class="text-[11px] text-primary-500 hover:text-primary-600">Download SVG</a>
        </div>
        <div class="flex flex-col items-center gap-2">
          <div class="w-12 h-12 flex items-center justify-center bg-gray-50 rounded-lg">
            <Menu />
          </div>
          <p class="text-xs font-medium text-gray-900">Menu</p>
          <a href="/icons/menu.svg" download class="text-[11px] text-primary-500 hover:text-primary-600">Download SVG</a>
        </div>
        <div class="flex flex-col items-center gap-2">
          <div class="w-12 h-12 flex items-center justify-center bg-gray-50 rounded-lg">
            <Search />
          </div>
          <p class="text-xs font-medium text-gray-900">Search</p>
          <a href="/icons/search.svg" download class="text-[11px] text-primary-500 hover:text-primary-600">Download SVG</a>
        </div>
        <div class="flex flex-col items-center gap-2">
          <div class="w-12 h-12 flex items-center justify-center bg-gray-50 rounded-lg">
            <MapPin />
          </div>
          <p class="text-xs font-medium text-gray-900">MapPin</p>
          <a href="/icons/map-pin.svg" download class="text-[11px] text-primary-500 hover:text-primary-600">Download SVG</a>
        </div>
        <div class="flex flex-col items-center gap-2">
          <div class="w-12 h-12 flex items-center justify-center bg-gray-50 rounded-lg">
            <Calendar />
          </div>
          <p class="text-xs font-medium text-gray-900">Calendar</p>
          <a href="/icons/calendar.svg" download class="text-[11px] text-primary-500 hover:text-primary-600">Download SVG</a>
        </div>
        <div class="flex flex-col items-center gap-2">
          <div class="w-12 h-12 flex items-center justify-center bg-gray-50 rounded-lg">
            <Phone />
          </div>
          <p class="text-xs font-medium text-gray-900">Phone</p>
          <a href="/icons/phone.svg" download class="text-[11px] text-primary-500 hover:text-primary-600">Download SVG</a>
        </div>
        <div class="flex flex-col items-center gap-2">
          <div class="w-12 h-12 flex items-center justify-center bg-gray-50 rounded-lg">
            <Mail />
          </div>
          <p class="text-xs font-medium text-gray-900">Mail</p>
          <a href="/icons/mail.svg" download class="text-[11px] text-primary-500 hover:text-primary-600">Download SVG</a>
        </div>
        <div class="flex flex-col items-center gap-2">
          <div class="w-12 h-12 flex items-center justify-center bg-gray-50 rounded-lg">
            <Star />
          </div>
          <p class="text-xs font-medium text-gray-900">Star</p>
          <a href="/icons/star.svg" download class="text-[11px] text-primary-500 hover:text-primary-600">Download SVG</a>
        </div>
        <div class="flex flex-col items-center gap-2">
          <div class="w-12 h-12 flex items-center justify-center bg-gray-50 rounded-lg">
            <Walking />
          </div>
          <p class="text-xs font-medium text-gray-900">Walking</p>
          <a href="/icons/walking.svg" download class="text-[11px] text-primary-500 hover:text-primary-600">Download SVG</a>
        </div>
        <div class="flex flex-col items-center gap-2">
          <div class="w-12 h-12 flex items-center justify-center bg-gray-50 rounded-lg">
            <Cycling />
          </div>
          <p class="text-xs font-medium text-gray-900">Cycling</p>
          <a href="/icons/cycling.svg" download class="text-[11px] text-primary-500 hover:text-primary-600">Download SVG</a>
        </div>
        <div class="flex flex-col items-center gap-2">
          <div class="w-12 h-12 flex items-center justify-center bg-gray-50 rounded-lg">
            <Mountain />
          </div>
          <p class="text-xs font-medium text-gray-900">Mountain</p>
          <a href="/icons/mountain.svg" download class="text-[11px] text-primary-500 hover:text-primary-600">Download SVG</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Sizes -->
  <section class="specimen-section">
    <h2>Sizes</h2>
    <p class="text-sm text-gray-600 mb-6 max-w-[65ch]">
      Pass a <code class="text-xs bg-gray-100 px-1.5 py-0.5 rounded-sm font-mono">size</code> prop to scale. Icons are designed on a 24px grid — smaller sizes work well down to 16px, larger sizes up to 32px.
    </p>
    <div class="border border-gray-200 rounded-lg overflow-hidden">
      <table class="w-full">
        <thead>
          <tr class="border-b border-gray-200 bg-gray-50">
            <th class="text-left py-3 px-4 text-xs font-semibold text-gray-500 uppercase tracking-wide">Size</th>
            <th class="text-center py-3 px-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">ArrowRight</th>
            <th class="text-center py-3 px-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">Close</th>
            <th class="text-center py-3 px-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">Search</th>
            <th class="text-center py-3 px-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">MapPin</th>
            <th class="text-center py-3 px-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">Calendar</th>
            <th class="text-center py-3 px-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">Star</th>
            <th class="text-center py-3 px-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">Walking</th>
            <th class="text-center py-3 px-3 text-xs font-semibold text-gray-500 uppercase tracking-wide">Mountain</th>
            <th class="text-left py-3 px-4 text-xs font-semibold text-gray-500 uppercase tracking-wide">Use case</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-gray-100">
            <td class="py-4 px-4 font-mono text-xs text-gray-500">16px</td>
            <td class="py-4 px-3 text-center"><ArrowRight size={16} /></td>
            <td class="py-4 px-3 text-center"><Close size={16} /></td>
            <td class="py-4 px-3 text-center"><Search size={16} /></td>
            <td class="py-4 px-3 text-center"><MapPin size={16} /></td>
            <td class="py-4 px-3 text-center"><Calendar size={16} /></td>
            <td class="py-4 px-3 text-center"><Star size={16} /></td>
            <td class="py-4 px-3 text-center"><Walking size={16} /></td>
            <td class="py-4 px-3 text-center"><Mountain size={16} /></td>
            <td class="py-4 px-4 text-sm text-gray-600">Small buttons, inline text, badges</td>
          </tr>
          <tr class="border-b border-gray-100">
            <td class="py-4 px-4 font-mono text-xs text-gray-500">20px</td>
            <td class="py-4 px-3 text-center"><ArrowRight size={20} /></td>
            <td class="py-4 px-3 text-center"><Close size={20} /></td>
            <td class="py-4 px-3 text-center"><Search size={20} /></td>
            <td class="py-4 px-3 text-center"><MapPin size={20} /></td>
            <td class="py-4 px-3 text-center"><Calendar size={20} /></td>
            <td class="py-4 px-3 text-center"><Star size={20} /></td>
            <td class="py-4 px-3 text-center"><Walking size={20} /></td>
            <td class="py-4 px-3 text-center"><Mountain size={20} /></td>
            <td class="py-4 px-4 text-sm text-gray-600">Default buttons, form elements, nav items</td>
          </tr>
          <tr class="border-b border-gray-100">
            <td class="py-4 px-4 font-mono text-xs text-gray-500">24px</td>
            <td class="py-4 px-3 text-center"><ArrowRight size={24} /></td>
            <td class="py-4 px-3 text-center"><Close size={24} /></td>
            <td class="py-4 px-3 text-center"><Search size={24} /></td>
            <td class="py-4 px-3 text-center"><MapPin size={24} /></td>
            <td class="py-4 px-3 text-center"><Calendar size={24} /></td>
            <td class="py-4 px-3 text-center"><Star size={24} /></td>
            <td class="py-4 px-3 text-center"><Walking size={24} /></td>
            <td class="py-4 px-3 text-center"><Mountain size={24} /></td>
            <td class="py-4 px-4 text-sm text-gray-600">Default (standalone), large buttons, headings</td>
          </tr>
          <tr>
            <td class="py-4 px-4 font-mono text-xs text-gray-500">32px</td>
            <td class="py-4 px-3 text-center"><ArrowRight size={32} /></td>
            <td class="py-4 px-3 text-center"><Close size={32} /></td>
            <td class="py-4 px-3 text-center"><Search size={32} /></td>
            <td class="py-4 px-3 text-center"><MapPin size={32} /></td>
            <td class="py-4 px-3 text-center"><Calendar size={32} /></td>
            <td class="py-4 px-3 text-center"><Star size={32} /></td>
            <td class="py-4 px-3 text-center"><Walking size={32} /></td>
            <td class="py-4 px-3 text-center"><Mountain size={32} /></td>
            <td class="py-4 px-4 text-sm text-gray-600">Feature icons, hero accents, empty states</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- Color Inheritance -->
  <section class="specimen-section">
    <h2>Color Inheritance</h2>
    <p class="text-sm text-gray-600 mb-6 max-w-[65ch]">
      Icons use <code class="text-xs bg-gray-100 px-1.5 py-0.5 rounded-sm font-mono">currentColor</code> for stroke — set the parent's <code class="text-xs bg-gray-100 px-1.5 py-0.5 rounded-sm font-mono">color</code> via Tailwind text color classes. No separate icon color prop needed.
    </p>
    <div class="border border-gray-200 rounded-lg p-8">
      <div class="flex flex-wrap gap-8 items-start">
        <!-- gray-900 -->
        <div class="flex flex-col items-center gap-4 text-gray-900">
          <div class="flex items-center gap-3">
            <ArrowRight size={28} />
            <MapPin size={28} />
            <Star size={28} />
          </div>
          <span class="text-xs font-mono text-gray-400">gray-900</span>
        </div>
        <!-- gray-600 -->
        <div class="flex flex-col items-center gap-4 text-gray-600">
          <div class="flex items-center gap-3">
            <ArrowRight size={28} />
            <MapPin size={28} />
            <Star size={28} />
          </div>
          <span class="text-xs font-mono text-gray-400">gray-600</span>
        </div>
        <!-- gray-400 -->
        <div class="flex flex-col items-center gap-4 text-gray-400">
          <div class="flex items-center gap-3">
            <ArrowRight size={28} />
            <MapPin size={28} />
            <Star size={28} />
          </div>
          <span class="text-xs font-mono text-gray-400">gray-400</span>
        </div>
        <!-- primary-500 -->
        <div class="flex flex-col items-center gap-4 text-primary-500">
          <div class="flex items-center gap-3">
            <ArrowRight size={28} />
            <MapPin size={28} />
            <Star size={28} />
          </div>
          <span class="text-xs font-mono text-gray-400">primary-500</span>
        </div>
        <!-- accent-500 -->
        <div class="flex flex-col items-center gap-4 text-accent-500">
          <div class="flex items-center gap-3">
            <ArrowRight size={28} />
            <MapPin size={28} />
            <Star size={28} />
          </div>
          <span class="text-xs font-mono text-gray-400">accent-500</span>
        </div>
      </div>
    </div>
  </section>

  <!-- On Backgrounds -->
  <section class="specimen-section">
    <h2>On Backgrounds</h2>
    <p class="text-sm text-gray-600 mb-6 max-w-[65ch]">
      Enclose icons in a shape with a background color when used as standalone visual elements (features, empty states). Don't scale raw icons beyond 32px — use a container instead.
    </p>
    <div class="border border-gray-200 rounded-lg p-8">
      <div class="flex flex-wrap gap-6 items-center">
        <div class="flex flex-col items-center gap-3">
          <div class="w-10 h-10 flex items-center justify-center bg-primary-50 text-primary-500 rounded-lg">
            <MapPin size={20} />
          </div>
          <span class="text-xs font-mono text-gray-400">tinted bg</span>
        </div>
        <div class="flex flex-col items-center gap-3">
          <div class="w-10 h-10 flex items-center justify-center bg-primary-500 text-white rounded-lg">
            <Calendar size={20} />
          </div>
          <span class="text-xs font-mono text-gray-400">solid bg</span>
        </div>
        <div class="flex flex-col items-center gap-3">
          <div class="w-10 h-10 flex items-center justify-center bg-accent-50 text-accent-500 rounded-lg">
            <Walking size={20} />
          </div>
          <span class="text-xs font-mono text-gray-400">accent tinted</span>
        </div>
        <div class="flex flex-col items-center gap-3">
          <div class="w-10 h-10 flex items-center justify-center bg-gray-100 text-gray-600 rounded-full">
            <Cycling size={20} />
          </div>
          <span class="text-xs font-mono text-gray-400">circle</span>
        </div>
        <div class="flex flex-col items-center gap-3">
          <div class="w-12 h-12 flex items-center justify-center bg-gray-900 text-white rounded-lg">
            <Mountain size={24} />
          </div>
          <span class="text-xs font-mono text-gray-400">dark</span>
        </div>
        <div class="flex flex-col items-center gap-3">
          <div class="w-14 h-14 flex items-center justify-center bg-primary-50 text-primary-500 rounded-xl">
            <Star size={28} />
          </div>
          <span class="text-xs font-mono text-gray-400">feature xl</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Inline with Text -->
  <section class="specimen-section">
    <h2>Inline with Text</h2>
    <p class="text-sm text-gray-600 mb-6 max-w-[65ch]">
      Icons pair with text at matching sizes. Use <code class="text-xs bg-gray-100 px-1.5 py-0.5 rounded-sm font-mono">inline-flex items-center gap-2</code> for alignment.
    </p>
    <div class="border border-gray-200 rounded-lg p-8">
      <div class="flex flex-col gap-6">
        <div class="flex flex-wrap gap-8 items-center">
          <span class="inline-flex items-center gap-2 text-sm text-primary-500">
            <span>View itinerary</span> <ArrowRight size={14} />
          </span>
          <span class="inline-flex items-center gap-2 text-sm text-gray-700">
            <Calendar size={16} /> <span>7 nights</span>
          </span>
          <span class="inline-flex items-center gap-2 text-sm text-gray-700">
            <MapPin size={16} /> <span>Provence, France</span>
          </span>
        </div>
        <div class="flex flex-wrap gap-8 items-center">
          <span class="inline-flex items-center gap-2 text-sm text-gray-700">
            <Walking size={16} /> <span>Walking holiday</span>
          </span>
          <span class="inline-flex items-center gap-2 text-sm text-gray-700">
            <Cycling size={16} /> <span>Cycling tour</span>
          </span>
          <span class="inline-flex items-center gap-1.5 text-sm text-accent-500">
            <Star size={14} /> <span>4.8 rating</span>
          </span>
        </div>
      </div>
    </div>
  </section>

</GalleryLayout>
