---
import GalleryLayout from '../../layouts/GalleryLayout.astro';
---

<GalleryLayout title="Contact" description="Visual wireframe for Contact page — contact methods, form, FAQs, office info." section="wireframes">
  <div class="gallery-specimen @container">
    <div class="max-w-[var(--container-max)] mx-auto space-y-12">

      <!-- Navigation -->
      <div class="bg-gray-100 border border-gray-300 rounded-md p-4 flex justify-between items-center">
        <span class="text-base font-semibold text-gray-700">Headwater</span>
        <div class="flex gap-6 text-sm text-gray-600">
          <span>Walking</span>
          <span>Cycling</span>
          <span>Holiday Types</span>
          <span>Destinations</span>
          <span>About</span>
        </div>
        <div class="flex gap-3 items-center">
          <div class="bg-gray-200 border border-gray-400 rounded px-3 py-1 text-xs text-gray-600">Search</div>
          <div class="text-xs font-semibold text-primary-600">Contact</div>
        </div>
      </div>

      <!-- Breadcrumbs -->
      <div class="text-xs text-gray-500 flex gap-2">
        <span>Home</span>
        <span>›</span>
        <span>Contact Us</span>
      </div>

      <!-- Hero Section -->
      <div class="text-center space-y-4 py-8">
        <h1 class="text-5xl font-bold text-gray-800">Get in Touch</h1>
        <p class="text-xl text-gray-600 max-w-[65ch] mx-auto">
          Our team of travel experts is here to help plan your perfect active holiday
        </p>
      </div>

      <!-- Contact Methods -->
      <section class="grid grid-cols-1 @md:grid-cols-3 gap-6">

        <!-- Phone -->
        <div class="bg-primary-50 border border-primary-200 rounded-lg p-6 text-center space-y-3">
          <div class="bg-primary-100 rounded-full w-16 h-16 mx-auto flex items-center justify-center text-2xl">
            📞
          </div>
          <div class="space-y-2">
            <h3 class="text-lg font-semibold text-gray-800">Call Us</h3>
            <p class="text-2xl font-bold text-primary-700">01606 720199</p>
            <p class="text-sm text-gray-600">Mon-Fri: 9am-7pm<br />Sat: 9am-5pm<br />Sun: Closed</p>
          </div>
        </div>

        <!-- Email -->
        <div class="bg-primary-50 border border-primary-200 rounded-lg p-6 text-center space-y-3">
          <div class="bg-primary-100 rounded-full w-16 h-16 mx-auto flex items-center justify-center text-2xl">
            ✉️
          </div>
          <div class="space-y-2">
            <h3 class="text-lg font-semibold text-gray-800">Email Us</h3>
            <p class="text-base font-semibold text-primary-700">sales@headwater.com</p>
            <p class="text-sm text-gray-600">We aim to respond within 24 hours</p>
          </div>
        </div>

        <!-- Brochure -->
        <div class="bg-primary-50 border border-primary-200 rounded-lg p-6 text-center space-y-3">
          <div class="bg-primary-100 rounded-full w-16 h-16 mx-auto flex items-center justify-center text-2xl">
            📖
          </div>
          <div class="space-y-2">
            <h3 class="text-lg font-semibold text-gray-800">Request Brochure</h3>
            <p class="text-sm text-gray-600">Get our full catalog delivered to your door</p>
            <button class="bg-primary-500 text-white rounded px-4 py-2 text-sm font-semibold mt-2">
              Request Now
            </button>
          </div>
        </div>

      </section>

      <!-- Main Content: Form + Info -->
      <div class="grid grid-cols-1 @lg:grid-cols-[2fr_1fr] gap-12">

        <!-- Contact Form -->
        <section class="space-y-6">
          <div class="space-y-2">
            <h2 class="text-3xl font-bold text-gray-800">Send us a message</h2>
            <p class="text-base text-gray-600">Fill out the form below and we'll get back to you as soon as possible</p>
          </div>

          <form class="space-y-6">

            <!-- Name Fields -->
            <div class="grid grid-cols-1 @md:grid-cols-2 gap-4">
              <div class="space-y-2">
                <label class="text-sm font-semibold text-gray-700">First Name *</label>
                <input type="text" class="w-full bg-white border border-gray-300 rounded px-4 py-3 text-sm text-gray-700" placeholder="John" />
              </div>
              <div class="space-y-2">
                <label class="text-sm font-semibold text-gray-700">Last Name *</label>
                <input type="text" class="w-full bg-white border border-gray-300 rounded px-4 py-3 text-sm text-gray-700" placeholder="Smith" />
              </div>
            </div>

            <!-- Email & Phone -->
            <div class="grid grid-cols-1 @md:grid-cols-2 gap-4">
              <div class="space-y-2">
                <label class="text-sm font-semibold text-gray-700">Email Address *</label>
                <input type="email" class="w-full bg-white border border-gray-300 rounded px-4 py-3 text-sm text-gray-700" placeholder="john@example.com" />
              </div>
              <div class="space-y-2">
                <label class="text-sm font-semibold text-gray-700">Phone Number</label>
                <input type="tel" class="w-full bg-white border border-gray-300 rounded px-4 py-3 text-sm text-gray-700" placeholder="07123 456789" />
              </div>
            </div>

            <!-- Subject -->
            <div class="space-y-2">
              <label class="text-sm font-semibold text-gray-700">Subject *</label>
              <select class="w-full bg-white border border-gray-300 rounded px-4 py-3 text-sm text-gray-700">
                <option>General Enquiry</option>
                <option>Holiday Information</option>
                <option>Booking Question</option>
                <option>Feedback</option>
                <option>Other</option>
              </select>
            </div>

            <!-- Message -->
            <div class="space-y-2">
              <label class="text-sm font-semibold text-gray-700">Message *</label>
              <textarea rows="6" class="w-full bg-white border border-gray-300 rounded px-4 py-3 text-sm text-gray-700" placeholder="Tell us how we can help..."></textarea>
            </div>

            <!-- Newsletter Opt-in -->
            <div class="space-y-3">
              <label class="flex items-start gap-3 cursor-pointer">
                <input type="checkbox" class="mt-1 w-4 h-4" />
                <span class="text-sm text-gray-700">Yes, I'd like to receive holiday inspiration, travel tips, and exclusive offers by email</span>
              </label>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="w-full bg-primary-500 text-white rounded-md px-8 py-4 text-base font-semibold">
              Send Message
            </button>

            <p class="text-xs text-gray-500">
              * Required fields. By submitting this form, you agree to our <a href="#" class="text-primary-600 underline">Privacy Policy</a>
            </p>

          </form>
        </section>

        <!-- Sidebar Info -->
        <aside class="space-y-6">

          <!-- Office Hours -->
          <div class="bg-gray-50 border border-gray-300 rounded-lg p-6 space-y-4">
            <h3 class="text-lg font-semibold text-gray-800">Office Hours</h3>
            <div class="space-y-2 text-sm text-gray-700">
              <div class="flex justify-between">
                <span>Monday - Friday</span>
                <span class="font-semibold">9am - 7pm</span>
              </div>
              <div class="flex justify-between">
                <span>Saturday</span>
                <span class="font-semibold">9am - 5pm</span>
              </div>
              <div class="flex justify-between">
                <span>Sunday</span>
                <span class="font-semibold">Closed</span>
              </div>
              <div class="flex justify-between pt-2 border-t border-gray-300">
                <span>Bank Holidays</span>
                <span class="font-semibold">Closed</span>
              </div>
            </div>
            <div class="bg-primary-50 border border-primary-200 rounded p-3">
              <p class="text-sm text-primary-800 font-semibold">🕐 We're open now until 7pm</p>
            </div>
          </div>

          <!-- Office Location -->
          <div class="bg-gray-50 border border-gray-300 rounded-lg p-6 space-y-4">
            <h3 class="text-lg font-semibold text-gray-800">Visit Us</h3>
            <div class="space-y-2 text-sm text-gray-700">
              <p class="font-semibold">Headwater Holidays</p>
              <p>
                The Old School House<br />
                Chester Road<br />
                Northwich, Cheshire<br />
                CW8 1LE<br />
                United Kingdom
              </p>
            </div>
            <div class="bg-gray-300 border border-gray-400 rounded h-40 flex items-center justify-center text-gray-500 text-xs">
              [ Map placeholder ]
            </div>
          </div>

          <!-- Quick Links -->
          <div class="bg-gray-50 border border-gray-300 rounded-lg p-6 space-y-4">
            <h3 class="text-lg font-semibold text-gray-800">Quick Links</h3>
            <div class="space-y-2">
              <a href="#" class="block text-sm text-primary-600 hover:underline">Request a Brochure</a>
              <a href="#" class="block text-sm text-primary-600 hover:underline">Frequently Asked Questions</a>
              <a href="#" class="block text-sm text-primary-600 hover:underline">Travel Insurance</a>
              <a href="#" class="block text-sm text-primary-600 hover:underline">Booking Conditions</a>
            </div>
          </div>

        </aside>

      </div>

      <!-- Common Questions -->
      <section class="space-y-6">
        <div class="text-center space-y-2">
          <h2 class="text-3xl font-bold text-gray-800">Common Questions</h2>
          <p class="text-base text-gray-600">Quick answers to frequently asked questions</p>
        </div>

        <div class="grid grid-cols-1 @md:grid-cols-2 gap-6">

          <!-- FAQ 1 -->
          <div class="bg-gray-50 border border-gray-300 rounded-lg p-6 space-y-3">
            <h3 class="text-base font-semibold text-gray-800">How do I book a holiday?</h3>
            <p class="text-sm text-gray-600">
              You can book online, call us on 01606 720199, or request a callback. Our team will guide you through the process and answer any questions.
            </p>
            <a href="#" class="text-sm text-primary-600 font-semibold">Learn more →</a>
          </div>

          <!-- FAQ 2 -->
          <div class="bg-gray-50 border border-gray-300 rounded-lg p-6 space-y-3">
            <h3 class="text-base font-semibold text-gray-800">What's included in the price?</h3>
            <p class="text-sm text-gray-600">
              All our holidays include accommodation, daily breakfast, luggage transfers, route notes, GPS navigation, and 24/7 support.
            </p>
            <a href="#" class="text-sm text-primary-600 font-semibold">View full details →</a>
          </div>

          <!-- FAQ 3 -->
          <div class="bg-gray-50 border border-gray-300 rounded-lg p-6 space-y-3">
            <h3 class="text-base font-semibold text-gray-800">Can you tailor-make a holiday?</h3>
            <p class="text-sm text-gray-600">
              Yes! We specialize in customizing holidays to suit your preferences, fitness level, and schedule. Contact us to discuss your requirements.
            </p>
            <a href="#" class="text-sm text-primary-600 font-semibold">Get in touch →</a>
          </div>

          <!-- FAQ 4 -->
          <div class="bg-gray-50 border border-gray-300 rounded-lg p-6 space-y-3">
            <h3 class="text-base font-semibold text-gray-800">Is my booking protected?</h3>
            <p class="text-sm text-gray-600">
              Yes. All our holidays are ABTA and ATOL protected, giving you complete financial protection and peace of mind.
            </p>
            <a href="#" class="text-sm text-primary-600 font-semibold">About protection →</a>
          </div>

        </div>

        <div class="text-center pt-4">
          <button class="text-base text-primary-600 font-semibold">View All FAQs →</button>
        </div>
      </section>

      <!-- Social Media -->
      <section class="bg-gray-50 border border-gray-300 rounded-lg p-12 text-center space-y-6">
        <h2 class="text-3xl font-bold text-gray-800">Follow Our Journey</h2>
        <p class="text-base text-gray-600">Get travel inspiration and updates on our social channels</p>

        <div class="flex gap-4 justify-center">
          <button class="bg-gray-200 border border-gray-400 rounded-lg p-4 w-14 h-14 flex items-center justify-center text-xl hover:bg-gray-300">
            f
          </button>
          <button class="bg-gray-200 border border-gray-400 rounded-lg p-4 w-14 h-14 flex items-center justify-center text-xl hover:bg-gray-300">
            📷
          </button>
          <button class="bg-gray-200 border border-gray-400 rounded-lg p-4 w-14 h-14 flex items-center justify-center text-xl hover:bg-gray-300">
            X
          </button>
          <button class="bg-gray-200 border border-gray-400 rounded-lg p-4 w-14 h-14 flex items-center justify-center text-xl hover:bg-gray-300">
            ▶
          </button>
          <button class="bg-gray-200 border border-gray-400 rounded-lg p-4 w-14 h-14 flex items-center justify-center text-xl hover:bg-gray-300">
            P
          </button>
        </div>
      </section>

      <!-- Trust Signals -->
      <section class="bg-primary-50 border border-primary-200 rounded-lg p-8">
        <div class="grid grid-cols-1 @md:grid-cols-3 gap-8 text-center">

          <div class="space-y-2">
            <div class="flex items-center justify-center gap-2">
              <span class="text-2xl">🛡️</span>
              <p class="text-lg font-semibold text-gray-800">ABTA & ATOL Protected</p>
            </div>
            <p class="text-sm text-gray-600">Complete financial protection for your peace of mind</p>
          </div>

          <div class="space-y-2">
            <div class="flex items-center justify-center gap-2">
              <span class="text-2xl">⭐</span>
              <p class="text-lg font-semibold text-gray-800">40+ Years Experience</p>
            </div>
            <p class="text-sm text-gray-600">Trusted by thousands of travelers since 1985</p>
          </div>

          <div class="space-y-2">
            <div class="flex items-center justify-center gap-2">
              <span class="text-2xl">💚</span>
              <p class="text-lg font-semibold text-gray-800">B-Corp Certified</p>
            </div>
            <p class="text-sm text-gray-600">Committed to sustainable and responsible travel</p>
          </div>

        </div>
      </section>

      <!-- Footer -->
      <div class="bg-gray-100 border border-gray-300 rounded-lg p-8">
        <div class="grid grid-cols-2 @md:grid-cols-4 gap-6 mb-6">
          <div class="space-y-2">
            <p class="text-base font-bold text-gray-800">Headwater</p>
            <p class="text-xs text-gray-600">Est. 1985</p>
            <div class="flex gap-2 text-xs text-gray-500">
              <span>ABTA</span>
              <span>ATOL</span>
            </div>
          </div>
          <div class="space-y-2">
            <p class="text-sm font-semibold text-gray-700">Destinations</p>
            <div class="space-y-1 text-xs text-gray-600">
              <p>Walking</p>
              <p>Cycling</p>
              <p>Multi-Activity</p>
              <p>View All</p>
            </div>
          </div>
          <div class="space-y-2">
            <p class="text-sm font-semibold text-gray-700">About</p>
            <div class="space-y-1 text-xs text-gray-600">
              <p>Our Story</p>
              <p>Team</p>
              <p>Reviews</p>
              <p>Press</p>
            </div>
          </div>
          <div class="space-y-2">
            <p class="text-sm font-semibold text-gray-700">Contact</p>
            <div class="space-y-1 text-xs text-gray-600">
              <p>01606 720199</p>
              <p>sales@headwater.com</p>
              <p>Brochure</p>
              <p>FAQ</p>
            </div>
          </div>
        </div>
        <div class="border-t border-gray-300 pt-4 text-center text-xs text-gray-500">
          © 2026 Headwater Holidays Ltd
        </div>
      </div>

    </div>
  </div>
</GalleryLayout>
