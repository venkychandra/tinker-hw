---
import GalleryLayout from '../../layouts/GalleryLayout.astro';
---

<GalleryLayout title="Home (Visual)" description="Visual wireframe of the home page layout — hierarchy, structure, and flow." section="wireframes">
  <div class="gallery-specimen @container">
    <div class="max-w-[var(--container-max)] mx-auto space-y-16">

      <!-- Navigation -->
      <div class="bg-gray-100 border border-gray-300 rounded-md p-4 flex justify-between items-center">
        <span class="text-base font-semibold text-gray-700">Headwater</span>
        <div class="flex gap-6 text-sm text-gray-600">
          <span>Destinations</span>
          <span>Holidays</span>
          <span>About</span>
          <span>Contact</span>
        </div>
        <div class="bg-gray-200 border border-gray-400 rounded px-3 py-1 text-xs text-gray-600">Search</div>
      </div>

      <!-- Hero Section -->
      <div class="bg-gray-200 border border-gray-400 rounded-lg p-16 text-center space-y-6">
        <div class="bg-gray-300 border border-gray-400 rounded h-64 flex items-center justify-center text-gray-500 text-sm">
          [ Full-bleed hero image ]
        </div>
        <div class="space-y-3">
          <p class="text-2xl font-bold text-gray-800">Experts in self-guided active holidays</p>
          <p class="text-lg text-gray-600">We plan the routes. You enjoy discovering them.</p>
        </div>
        <div class="flex gap-4 justify-center">
          <div class="bg-primary-500 text-white px-6 py-3 rounded-md text-sm font-semibold">Find a Holiday</div>
          <div class="bg-gray-100 border border-gray-400 px-6 py-3 rounded-md text-sm font-semibold text-gray-700">Request Brochure</div>
        </div>
      </div>

      <!-- Holiday Types Section -->
      <div class="space-y-6">
        <div class="text-center space-y-2">
          <p class="text-xl font-bold text-gray-800">Explore our holidays</p>
          <p class="text-base text-gray-600">Walking, cycling, and multi-activity tours</p>
        </div>
        <div class="grid grid-cols-1 @md:grid-cols-3 gap-6">
          <div class="bg-gray-100 border border-gray-300 rounded-lg overflow-hidden">
            <div class="bg-gray-300 border-b border-gray-400 h-40 flex items-center justify-center text-gray-500 text-sm">
              [ Image ]
            </div>
            <div class="p-6 space-y-3">
              <p class="text-lg font-semibold text-gray-800">Walking</p>
              <p class="text-sm text-gray-600">Self-guided holidays</p>
              <div class="bg-gray-200 border border-gray-400 px-4 py-2 rounded text-xs text-gray-700 inline-block">View trips</div>
            </div>
          </div>
          <div class="bg-gray-100 border border-gray-300 rounded-lg overflow-hidden">
            <div class="bg-gray-300 border-b border-gray-400 h-40 flex items-center justify-center text-gray-500 text-sm">
              [ Image ]
            </div>
            <div class="p-6 space-y-3">
              <p class="text-lg font-semibold text-gray-800">Cycling</p>
              <p class="text-sm text-gray-600">Scenic routes with e-bikes</p>
              <div class="bg-gray-200 border border-gray-400 px-4 py-2 rounded text-xs text-gray-700 inline-block">View trips</div>
            </div>
          </div>
          <div class="bg-gray-100 border border-gray-300 rounded-lg overflow-hidden">
            <div class="bg-gray-300 border-b border-gray-400 h-40 flex items-center justify-center text-gray-500 text-sm">
              [ Image ]
            </div>
            <div class="p-6 space-y-3">
              <p class="text-lg font-semibold text-gray-800">Multi-Activity</p>
              <p class="text-sm text-gray-600">Walk & cycle combined</p>
              <div class="bg-gray-200 border border-gray-400 px-4 py-2 rounded text-xs text-gray-700 inline-block">View trips</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Featured Destinations Section -->
      <div class="space-y-6">
        <div class="text-center">
          <p class="text-xl font-bold text-gray-800">Featured destinations</p>
        </div>
        <div class="grid grid-cols-2 @md:grid-cols-4 gap-4">
          <div class="bg-gray-100 border border-gray-300 rounded-lg overflow-hidden">
            <div class="bg-gray-300 border-b border-gray-400 h-32 flex items-center justify-center text-gray-500 text-xs">
              [ Image ]
            </div>
            <div class="p-4 text-center space-y-1">
              <p class="text-sm font-semibold text-gray-800">Tuscany</p>
              <p class="text-xs text-gray-600">Walking</p>
            </div>
          </div>
          <div class="bg-gray-100 border border-gray-300 rounded-lg overflow-hidden">
            <div class="bg-gray-300 border-b border-gray-400 h-32 flex items-center justify-center text-gray-500 text-xs">
              [ Image ]
            </div>
            <div class="p-4 text-center space-y-1">
              <p class="text-sm font-semibold text-gray-800">Camino de Santiago</p>
              <p class="text-xs text-gray-600">Walking</p>
            </div>
          </div>
          <div class="bg-gray-100 border border-gray-300 rounded-lg overflow-hidden">
            <div class="bg-gray-300 border-b border-gray-400 h-32 flex items-center justify-center text-gray-500 text-xs">
              [ Image ]
            </div>
            <div class="p-4 text-center space-y-1">
              <p class="text-sm font-semibold text-gray-800">Dordogne</p>
              <p class="text-xs text-gray-600">Cycling</p>
            </div>
          </div>
          <div class="bg-gray-100 border border-gray-300 rounded-lg overflow-hidden">
            <div class="bg-gray-300 border-b border-gray-400 h-32 flex items-center justify-center text-gray-500 text-xs">
              [ Image ]
            </div>
            <div class="p-4 text-center space-y-1">
              <p class="text-sm font-semibold text-gray-800">Croatia</p>
              <p class="text-xs text-gray-600">Walking</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Why Headwater Section -->
      <div class="space-y-6">
        <div class="text-center space-y-2">
          <p class="text-xl font-bold text-gray-800">Why travel with Headwater?</p>
          <p class="text-base text-gray-600">40+ years of active holiday expertise</p>
        </div>
        <div class="grid grid-cols-1 @md:grid-cols-3 gap-6">
          <div class="bg-gray-100 border border-gray-300 rounded-lg p-6 space-y-2">
            <p class="text-base font-semibold text-gray-800">Hand-picked hotels</p>
            <p class="text-sm text-gray-600">Quality stays every night</p>
          </div>
          <div class="bg-gray-100 border border-gray-300 rounded-lg p-6 space-y-2">
            <p class="text-base font-semibold text-gray-800">Award-winning routes</p>
            <p class="text-sm text-gray-600">Tested by our team</p>
          </div>
          <div class="bg-gray-100 border border-gray-300 rounded-lg p-6 space-y-2">
            <p class="text-base font-semibold text-gray-800">GPS & route notes</p>
            <p class="text-sm text-gray-600">Navigation included</p>
          </div>
          <div class="bg-gray-100 border border-gray-300 rounded-lg p-6 space-y-2">
            <p class="text-base font-semibold text-gray-800">Local experiences</p>
            <p class="text-sm text-gray-600">Authentic cuisine & wine</p>
          </div>
          <div class="bg-gray-100 border border-gray-300 rounded-lg p-6 space-y-2">
            <p class="text-base font-semibold text-gray-800">Tailor-made service</p>
            <p class="text-sm text-gray-600">Expert advice since 1985</p>
          </div>
          <div class="bg-gray-100 border border-gray-300 rounded-lg p-6 space-y-2">
            <p class="text-base font-semibold text-gray-800">ABTA/ATOL protected</p>
            <p class="text-sm text-gray-600">Peace of mind</p>
          </div>
        </div>
      </div>

      <!-- Testimonials Section -->
      <div class="space-y-6">
        <div class="text-center">
          <p class="text-xl font-bold text-gray-800">What our guests say</p>
        </div>
        <div class="grid grid-cols-1 @md:grid-cols-2 gap-6">
          <div class="bg-gray-100 border border-gray-300 rounded-lg p-8 space-y-4">
            <p class="text-base text-gray-700 italic">"Outstanding organization..."</p>
            <div class="space-y-1">
              <p class="text-sm text-gray-600">— Name, Location</p>
              <p class="text-accent-500 text-sm">★★★★★</p>
            </div>
          </div>
          <div class="bg-gray-100 border border-gray-300 rounded-lg p-8 space-y-4">
            <p class="text-base text-gray-700 italic">"The route notes were perfect..."</p>
            <div class="space-y-1">
              <p class="text-sm text-gray-600">— Name, Location</p>
              <p class="text-accent-500 text-sm">★★★★★</p>
            </div>
          </div>
        </div>
      </div>

      <!-- CTA Section -->
      <div class="bg-gray-200 border border-gray-400 rounded-lg p-12 text-center space-y-4">
        <p class="text-xl font-bold text-gray-800">Find your perfect active holiday</p>
        <p class="text-base text-gray-600">Tell us what you're looking for and we'll help</p>
        <div class="bg-primary-500 text-white px-8 py-3 rounded-md text-sm font-semibold inline-block">Find a Holiday</div>
      </div>

      <!-- Footer -->
      <div class="bg-gray-100 border border-gray-300 rounded-lg p-8">
        <div class="grid grid-cols-2 @md:grid-cols-4 gap-6 mb-6">
          <div class="space-y-2">
            <p class="text-base font-bold text-gray-800">Headwater</p>
            <p class="text-xs text-gray-600">Est. 1985</p>
            <div class="flex gap-2 text-xs text-gray-500">
              <span>ABTA</span>
              <span>ATOL</span>
            </div>
          </div>
          <div class="space-y-2">
            <p class="text-sm font-semibold text-gray-700">Destinations</p>
            <div class="space-y-1 text-xs text-gray-600">
              <p>Walking</p>
              <p>Cycling</p>
              <p>Multi-Activity</p>
              <p>View All</p>
            </div>
          </div>
          <div class="space-y-2">
            <p class="text-sm font-semibold text-gray-700">About</p>
            <div class="space-y-1 text-xs text-gray-600">
              <p>Our Story</p>
              <p>Team</p>
              <p>Reviews</p>
              <p>Press</p>
            </div>
          </div>
          <div class="space-y-2">
            <p class="text-sm font-semibold text-gray-700">Contact</p>
            <div class="space-y-1 text-xs text-gray-600">
              <p>01606 813333</p>
              <p>Email</p>
              <p>Brochure</p>
              <p>FAQ</p>
            </div>
          </div>
        </div>
        <div class="border-t border-gray-300 pt-4 text-center text-xs text-gray-500">
          © 2026 Headwater Holidays Ltd
        </div>
      </div>

    </div>
  </div>
</GalleryLayout>
