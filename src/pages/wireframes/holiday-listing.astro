---
import GalleryLayout from '../../layouts/GalleryLayout.astro';
---

<GalleryLayout title="Holiday Listing" description="Visual wireframe for Walking/Cycling holiday listing pages — filters, grid, pagination." section="wireframes">
  <div class="gallery-specimen @container">
    <div class="max-w-[var(--container-max)] mx-auto space-y-12">

      <!-- Navigation -->
      <div class="bg-gray-100 border border-gray-300 rounded-md p-4 flex justify-between items-center">
        <span class="text-base font-semibold text-gray-700">Headwater</span>
        <div class="flex gap-6 text-sm text-gray-600">
          <span class="font-semibold text-primary-600">Walking</span>
          <span>Cycling</span>
          <span>Holiday Types</span>
          <span>Destinations</span>
        </div>
        <div class="flex gap-3 items-center">
          <div class="bg-gray-200 border border-gray-400 rounded px-3 py-1 text-xs text-gray-600">Search</div>
          <div class="text-xs text-gray-600">Contact</div>
        </div>
      </div>

      <!-- Breadcrumbs -->
      <div class="text-xs text-gray-500 flex gap-2">
        <span>Home</span>
        <span>›</span>
        <span>Walking Holidays</span>
      </div>

      <!-- Page Header -->
      <div class="space-y-3">
        <h1 class="text-4xl font-bold text-gray-800">Walking Holidays</h1>
        <p class="text-lg text-gray-600 max-w-[70ch]">Self-guided walking adventures across Europe and beyond. Hand-picked hotels, award-winning routes, and authentic local experiences.</p>
      </div>

      <!-- Filters & Results Layout -->
      <div class="grid grid-cols-1 @lg:grid-cols-[280px_1fr] gap-8">

        <!-- Sidebar Filters -->
        <aside class="space-y-6">
          <div class="bg-gray-100 border border-gray-300 rounded-lg p-4">
            <p class="text-sm font-semibold text-gray-700 mb-3">Filter Results</p>

            <!-- Destination Filter -->
            <div class="space-y-2 mb-4 pb-4 border-b border-gray-300">
              <p class="text-xs font-semibold text-gray-700">Destination</p>
              <div class="space-y-1.5 text-xs text-gray-600">
                <label class="flex items-center gap-2">
                  <input type="checkbox" class="w-3 h-3" />
                  <span>France (24)</span>
                </label>
                <label class="flex items-center gap-2">
                  <input type="checkbox" class="w-3 h-3" />
                  <span>Italy (18)</span>
                </label>
                <label class="flex items-center gap-2">
                  <input type="checkbox" class="w-3 h-3" />
                  <span>Spain (16)</span>
                </label>
                <label class="flex items-center gap-2">
                  <input type="checkbox" class="w-3 h-3" />
                  <span>UK (12)</span>
                </label>
                <button class="text-primary-600 text-xs">+ Show more</button>
              </div>
            </div>

            <!-- Activity Level Filter -->
            <div class="space-y-2 mb-4 pb-4 border-b border-gray-300">
              <p class="text-xs font-semibold text-gray-700">Activity Level</p>
              <div class="space-y-1.5 text-xs text-gray-600">
                <label class="flex items-center gap-2">
                  <input type="checkbox" class="w-3 h-3" />
                  <span>Easy (8)</span>
                </label>
                <label class="flex items-center gap-2">
                  <input type="checkbox" class="w-3 h-3" />
                  <span>Moderate (32)</span>
                </label>
                <label class="flex items-center gap-2">
                  <input type="checkbox" class="w-3 h-3" />
                  <span>Challenging (14)</span>
                </label>
              </div>
            </div>

            <!-- Duration Filter -->
            <div class="space-y-2 mb-4 pb-4 border-b border-gray-300">
              <p class="text-xs font-semibold text-gray-700">Duration</p>
              <div class="space-y-1.5 text-xs text-gray-600">
                <label class="flex items-center gap-2">
                  <input type="checkbox" class="w-3 h-3" />
                  <span>3-5 days (6)</span>
                </label>
                <label class="flex items-center gap-2">
                  <input type="checkbox" class="w-3 h-3" />
                  <span>6-8 days (28)</span>
                </label>
                <label class="flex items-center gap-2">
                  <input type="checkbox" class="w-3 h-3" />
                  <span>9+ days (20)</span>
                </label>
              </div>
            </div>

            <!-- Price Filter -->
            <div class="space-y-2 mb-4">
              <p class="text-xs font-semibold text-gray-700">Price Range</p>
              <div class="bg-gray-200 h-2 rounded-full">
                <div class="bg-primary-500 h-2 rounded-full w-2/3"></div>
              </div>
              <div class="flex justify-between text-xs text-gray-600">
                <span>£500</span>
                <span>£2500</span>
              </div>
            </div>

            <!-- Clear Filters -->
            <button class="w-full bg-gray-200 border border-gray-400 rounded px-4 py-2 text-xs text-gray-700 font-semibold">
              Clear All Filters
            </button>
          </div>

          <!-- Popular Destinations Promo -->
          <div class="bg-gray-100 border border-gray-300 rounded-lg p-4 space-y-2">
            <p class="text-sm font-semibold text-gray-700">Popular Routes</p>
            <p class="text-xs text-gray-600">Camino de Santiago, Tuscany, Lake District</p>
            <button class="text-xs text-primary-600">View all</button>
          </div>
        </aside>

        <!-- Main Content -->
        <main class="space-y-6">

          <!-- Results Header -->
          <div class="flex justify-between items-center pb-4 border-b border-gray-300">
            <p class="text-sm text-gray-600">Showing <span class="font-semibold">54 holidays</span></p>
            <div class="flex gap-3 items-center">
              <span class="text-xs text-gray-600">Sort by:</span>
              <select class="bg-gray-100 border border-gray-300 rounded px-3 py-1.5 text-xs text-gray-700">
                <option>Recommended</option>
                <option>Price: Low to High</option>
                <option>Duration</option>
              </select>
            </div>
          </div>

          <!-- Holiday Cards Grid -->
          <div class="grid grid-cols-1 @md:grid-cols-2 @xl:grid-cols-3 gap-6">

            <!-- Holiday Card 1 -->
            <div class="bg-gray-100 border border-gray-300 rounded-lg overflow-hidden hover:shadow-md transition-shadow">
              <div class="bg-gray-300 border-b border-gray-400 h-48 flex items-center justify-center text-gray-500 text-sm relative">
                [ Holiday Image ]
                <span class="absolute top-3 right-3 bg-accent-500 text-white px-2 py-1 rounded text-xs font-semibold">Featured</span>
              </div>
              <div class="p-4 space-y-3">
                <div class="flex items-start justify-between gap-2">
                  <div class="space-y-1">
                    <p class="text-sm font-semibold text-gray-800">Tuscany Walking</p>
                    <p class="text-xs text-gray-600">Italy · Self-Guided</p>
                  </div>
                  <div class="text-xs text-gray-600 flex items-center gap-1">
                    <span class="text-accent-500">★</span>
                    <span class="font-semibold">4.8</span>
                  </div>
                </div>
                <p class="text-xs text-gray-600 line-clamp-2">Discover rolling hills, medieval villages, and world-class wine regions...</p>
                <div class="flex items-center justify-between pt-2 border-t border-gray-300">
                  <div class="text-xs text-gray-600">
                    <span class="font-semibold">7 days</span> · Moderate
                  </div>
                  <div class="text-right">
                    <p class="text-xs text-gray-600">from</p>
                    <p class="text-base font-bold text-gray-800">£1,245</p>
                  </div>
                </div>
                <button class="w-full bg-primary-500 text-white rounded px-4 py-2 text-xs font-semibold">
                  View Holiday
                </button>
              </div>
            </div>

            <!-- Holiday Card 2 -->
            <div class="bg-gray-100 border border-gray-300 rounded-lg overflow-hidden">
              <div class="bg-gray-300 border-b border-gray-400 h-48 flex items-center justify-center text-gray-500 text-sm">
                [ Holiday Image ]
              </div>
              <div class="p-4 space-y-3">
                <div class="flex items-start justify-between gap-2">
                  <div class="space-y-1">
                    <p class="text-sm font-semibold text-gray-800">Camino de Santiago</p>
                    <p class="text-xs text-gray-600">Spain · Self-Guided</p>
                  </div>
                  <div class="text-xs text-gray-600 flex items-center gap-1">
                    <span class="text-accent-500">★</span>
                    <span class="font-semibold">4.9</span>
                  </div>
                </div>
                <p class="text-xs text-gray-600 line-clamp-2">Walk the ancient pilgrimage route through northern Spain...</p>
                <div class="flex items-center justify-between pt-2 border-t border-gray-300">
                  <div class="text-xs text-gray-600">
                    <span class="font-semibold">8 days</span> · Moderate
                  </div>
                  <div class="text-right">
                    <p class="text-xs text-gray-600">from</p>
                    <p class="text-base font-bold text-gray-800">£995</p>
                  </div>
                </div>
                <button class="w-full bg-gray-200 border border-gray-400 rounded px-4 py-2 text-xs font-semibold text-gray-700">
                  View Holiday
                </button>
              </div>
            </div>

            <!-- Holiday Card 3 -->
            <div class="bg-gray-100 border border-gray-300 rounded-lg overflow-hidden">
              <div class="bg-gray-300 border-b border-gray-400 h-48 flex items-center justify-center text-gray-500 text-sm">
                [ Holiday Image ]
              </div>
              <div class="p-4 space-y-3">
                <div class="flex items-start justify-between gap-2">
                  <div class="space-y-1">
                    <p class="text-sm font-semibold text-gray-800">Dolomites Trek</p>
                    <p class="text-xs text-gray-600">Italy · Self-Guided</p>
                  </div>
                  <div class="text-xs text-gray-600 flex items-center gap-1">
                    <span class="text-accent-500">★</span>
                    <span class="font-semibold">4.7</span>
                  </div>
                </div>
                <p class="text-xs text-gray-600 line-clamp-2">Mountain walking through dramatic alpine scenery...</p>
                <div class="flex items-center justify-between pt-2 border-t border-gray-300">
                  <div class="text-xs text-gray-600">
                    <span class="font-semibold">6 days</span> · Challenging
                  </div>
                  <div class="text-right">
                    <p class="text-xs text-gray-600">from</p>
                    <p class="text-base font-bold text-gray-800">£1,495</p>
                  </div>
                </div>
                <button class="w-full bg-gray-200 border border-gray-400 rounded px-4 py-2 text-xs font-semibold text-gray-700">
                  View Holiday
                </button>
              </div>
            </div>

            <!-- Holiday Card 4 -->
            <div class="bg-gray-100 border border-gray-300 rounded-lg overflow-hidden">
              <div class="bg-gray-300 border-b border-gray-400 h-48 flex items-center justify-center text-gray-500 text-sm">
                [ Holiday Image ]
              </div>
              <div class="p-4 space-y-3">
                <div class="flex items-start justify-between gap-2">
                  <div class="space-y-1">
                    <p class="text-sm font-semibold text-gray-800">Cotswolds Way</p>
                    <p class="text-xs text-gray-600">UK · Self-Guided</p>
                  </div>
                  <div class="text-xs text-gray-600 flex items-center gap-1">
                    <span class="text-accent-500">★</span>
                    <span class="font-semibold">4.6</span>
                  </div>
                </div>
                <p class="text-xs text-gray-600 line-clamp-2">Gentle walks through quintessential English countryside...</p>
                <div class="flex items-center justify-between pt-2 border-t border-gray-300">
                  <div class="text-xs text-gray-600">
                    <span class="font-semibold">5 days</span> · Easy
                  </div>
                  <div class="text-right">
                    <p class="text-xs text-gray-600">from</p>
                    <p class="text-base font-bold text-gray-800">£795</p>
                  </div>
                </div>
                <button class="w-full bg-gray-200 border border-gray-400 rounded px-4 py-2 text-xs font-semibold text-gray-700">
                  View Holiday
                </button>
              </div>
            </div>

            <!-- Holiday Card 5 -->
            <div class="bg-gray-100 border border-gray-300 rounded-lg overflow-hidden">
              <div class="bg-gray-300 border-b border-gray-400 h-48 flex items-center justify-center text-gray-500 text-sm">
                [ Holiday Image ]
              </div>
              <div class="p-4 space-y-3">
                <div class="flex items-start justify-between gap-2">
                  <div class="space-y-1">
                    <p class="text-sm font-semibold text-gray-800">Portuguese Coast</p>
                    <p class="text-xs text-gray-600">Portugal · Self-Guided</p>
                  </div>
                  <div class="text-xs text-gray-600 flex items-center gap-1">
                    <span class="text-accent-500">★</span>
                    <span class="font-semibold">4.8</span>
                  </div>
                </div>
                <p class="text-xs text-gray-600 line-clamp-2">Walk along stunning coastal paths and traditional villages...</p>
                <div class="flex items-center justify-between pt-2 border-t border-gray-300">
                  <div class="text-xs text-gray-600">
                    <span class="font-semibold">7 days</span> · Moderate
                  </div>
                  <div class="text-right">
                    <p class="text-xs text-gray-600">from</p>
                    <p class="text-base font-bold text-gray-800">£1,095</p>
                  </div>
                </div>
                <button class="w-full bg-gray-200 border border-gray-400 rounded px-4 py-2 text-xs font-semibold text-gray-700">
                  View Holiday
                </button>
              </div>
            </div>

            <!-- Holiday Card 6 -->
            <div class="bg-gray-100 border border-gray-300 rounded-lg overflow-hidden">
              <div class="bg-gray-300 border-b border-gray-400 h-48 flex items-center justify-center text-gray-500 text-sm">
                [ Holiday Image ]
              </div>
              <div class="p-4 space-y-3">
                <div class="flex items-start justify-between gap-2">
                  <div class="space-y-1">
                    <p class="text-sm font-semibold text-gray-800">Swiss Alps Trail</p>
                    <p class="text-xs text-gray-600">Switzerland · Self-Guided</p>
                  </div>
                  <div class="text-xs text-gray-600 flex items-center gap-1">
                    <span class="text-accent-500">★</span>
                    <span class="font-semibold">4.9</span>
                  </div>
                </div>
                <p class="text-xs text-gray-600 line-clamp-2">Breathtaking mountain scenery and alpine villages...</p>
                <div class="flex items-center justify-between pt-2 border-t border-gray-300">
                  <div class="text-xs text-gray-600">
                    <span class="font-semibold">8 days</span> · Challenging
                  </div>
                  <div class="text-right">
                    <p class="text-xs text-gray-600">from</p>
                    <p class="text-base font-bold text-gray-800">£1,795</p>
                  </div>
                </div>
                <button class="w-full bg-gray-200 border border-gray-400 rounded px-4 py-2 text-xs font-semibold text-gray-700">
                  View Holiday
                </button>
              </div>
            </div>

          </div>

          <!-- Pagination -->
          <div class="flex justify-center items-center gap-2 pt-6">
            <button class="bg-gray-100 border border-gray-300 rounded px-3 py-2 text-xs text-gray-600">Previous</button>
            <button class="bg-primary-500 text-white rounded px-3 py-2 text-xs font-semibold">1</button>
            <button class="bg-gray-100 border border-gray-300 rounded px-3 py-2 text-xs text-gray-700">2</button>
            <button class="bg-gray-100 border border-gray-300 rounded px-3 py-2 text-xs text-gray-700">3</button>
            <button class="bg-gray-100 border border-gray-300 rounded px-3 py-2 text-xs text-gray-700">4</button>
            <span class="text-xs text-gray-500">...</span>
            <button class="bg-gray-100 border border-gray-300 rounded px-3 py-2 text-xs text-gray-700">12</button>
            <button class="bg-gray-100 border border-gray-300 rounded px-3 py-2 text-xs text-gray-600">Next</button>
          </div>

        </main>
      </div>

      <!-- CTA Section -->
      <div class="bg-gray-200 border border-gray-400 rounded-lg p-12 text-center space-y-4">
        <p class="text-xl font-bold text-gray-800">Can't find what you're looking for?</p>
        <p class="text-base text-gray-600">Our team can help you plan the perfect walking holiday</p>
        <div class="flex gap-3 justify-center">
          <button class="bg-primary-500 text-white px-6 py-3 rounded-md text-sm font-semibold">Contact Us</button>
          <button class="bg-gray-100 border border-gray-400 px-6 py-3 rounded-md text-sm font-semibold text-gray-700">Request Brochure</button>
        </div>
      </div>

      <!-- Footer -->
      <div class="bg-gray-100 border border-gray-300 rounded-lg p-8">
        <div class="grid grid-cols-2 @md:grid-cols-4 gap-6 mb-6">
          <div class="space-y-2">
            <p class="text-base font-bold text-gray-800">Headwater</p>
            <p class="text-xs text-gray-600">Est. 1985</p>
            <div class="flex gap-2 text-xs text-gray-500">
              <span>ABTA</span>
              <span>ATOL</span>
            </div>
          </div>
          <div class="space-y-2">
            <p class="text-sm font-semibold text-gray-700">Destinations</p>
            <div class="space-y-1 text-xs text-gray-600">
              <p>Walking</p>
              <p>Cycling</p>
              <p>Multi-Activity</p>
              <p>View All</p>
            </div>
          </div>
          <div class="space-y-2">
            <p class="text-sm font-semibold text-gray-700">About</p>
            <div class="space-y-1 text-xs text-gray-600">
              <p>Our Story</p>
              <p>Team</p>
              <p>Reviews</p>
              <p>Press</p>
            </div>
          </div>
          <div class="space-y-2">
            <p class="text-sm font-semibold text-gray-700">Contact</p>
            <div class="space-y-1 text-xs text-gray-600">
              <p>01606 720199</p>
              <p>sales@headwater.com</p>
              <p>Brochure</p>
              <p>FAQ</p>
            </div>
          </div>
        </div>
        <div class="border-t border-gray-300 pt-4 text-center text-xs text-gray-500">
          © 2026 Headwater Holidays Ltd
        </div>
      </div>

    </div>
  </div>
</GalleryLayout>
