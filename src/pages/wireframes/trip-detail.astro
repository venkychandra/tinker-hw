---
import GalleryLayout from '../../layouts/GalleryLayout.astro';
---

<GalleryLayout title="Trip Detail" description="Visual wireframe for individual holiday detail page — hero, itinerary, booking sidebar, reviews." section="wireframes">
  <div class="gallery-specimen @container">
    <div class="max-w-[var(--container-max)] mx-auto space-y-12">

      <!-- Navigation -->
      <div class="bg-gray-100 border border-gray-300 rounded-md p-4 flex justify-between items-center">
        <span class="text-base font-semibold text-gray-700">Headwater</span>
        <div class="flex gap-6 text-sm text-gray-600">
          <span>Walking</span>
          <span>Cycling</span>
          <span>Holiday Types</span>
          <span>Destinations</span>
        </div>
        <div class="flex gap-3 items-center">
          <div class="bg-gray-200 border border-gray-400 rounded px-3 py-1 text-xs text-gray-600">Search</div>
          <div class="text-xs text-gray-600">Contact</div>
        </div>
      </div>

      <!-- Breadcrumbs -->
      <div class="text-xs text-gray-500 flex gap-2">
        <span>Home</span>
        <span>›</span>
        <span>Walking Holidays</span>
        <span>›</span>
        <span>Italy</span>
        <span>›</span>
        <span>Tuscany Walking</span>
      </div>

      <!-- Hero Image Gallery -->
      <div class="grid grid-cols-4 gap-2 h-[400px]">
        <div class="col-span-3 bg-gray-300 border border-gray-400 rounded-lg flex items-center justify-center text-gray-500">
          [ Main Hero Image ]
        </div>
        <div class="space-y-2">
          <div class="bg-gray-300 border border-gray-400 rounded flex-1 h-[calc(50%-4px)] flex items-center justify-center text-xs text-gray-500">
            [ Image 2 ]
          </div>
          <div class="bg-gray-300 border border-gray-400 rounded flex-1 h-[calc(50%-4px)] flex items-center justify-center text-xs text-gray-500 relative">
            [ Image 3 ]
            <span class="absolute inset-0 bg-gray-900/50 flex items-center justify-center text-white text-xs font-semibold rounded">
              +12 more
            </span>
          </div>
        </div>
      </div>

      <!-- Page Title & Meta -->
      <div class="space-y-3">
        <div class="flex items-start justify-between gap-4">
          <div class="space-y-2">
            <h1 class="text-4xl font-bold text-gray-800">Tuscany Walking Holiday</h1>
            <div class="flex items-center gap-4 text-sm text-gray-600">
              <span class="flex items-center gap-1">
                <span class="text-accent-500">★</span>
                <span class="font-semibold">4.8</span>
                <span>(127 reviews)</span>
              </span>
              <span>·</span>
              <span>📍 Tuscany, Italy</span>
              <span>·</span>
              <span>Self-Guided</span>
            </div>
          </div>
          <div class="flex gap-2">
            <button class="bg-gray-100 border border-gray-300 rounded p-2 text-xs text-gray-600">
              🔗 Share
            </button>
            <button class="bg-gray-100 border border-gray-300 rounded p-2 text-xs text-gray-600">
              ♡ Save
            </button>
          </div>
        </div>
      </div>

      <!-- Main Content + Sidebar Layout -->
      <div class="grid grid-cols-1 @lg:grid-cols-[1fr_380px] gap-12">

        <!-- Main Content -->
        <main class="space-y-12">

          <!-- Overview -->
          <section class="space-y-4">
            <h2 class="text-2xl font-bold text-gray-800">Overview</h2>
            <p class="text-base text-gray-600 leading-relaxed">
              Discover the rolling hills, medieval villages, and world-class wine regions of Tuscany on this self-guided walking holiday. Walk through cypress-lined paths, explore historic towns like San Gimignano and Montepulciano, and stay in carefully selected hotels featuring local cuisine and hospitality.
            </p>
            <p class="text-base text-gray-600 leading-relaxed">
              This moderate-level walking tour covers approximately 10-15km per day through some of Italy's most beautiful countryside. You'll have detailed route notes and GPS navigation via our Headwater app, giving you the freedom to explore at your own pace.
            </p>
          </section>

          <!-- Quick Facts -->
          <section class="grid grid-cols-2 @md:grid-cols-4 gap-4">
            <div class="bg-gray-100 border border-gray-300 rounded-lg p-4 space-y-1">
              <p class="text-xs text-gray-600">Duration</p>
              <p class="text-lg font-bold text-gray-800">7 days</p>
            </div>
            <div class="bg-gray-100 border border-gray-300 rounded-lg p-4 space-y-1">
              <p class="text-xs text-gray-600">Activity Level</p>
              <p class="text-lg font-bold text-gray-800">Moderate</p>
            </div>
            <div class="bg-gray-100 border border-gray-300 rounded-lg p-4 space-y-1">
              <p class="text-xs text-gray-600">Distance</p>
              <p class="text-lg font-bold text-gray-800">10-15km/day</p>
            </div>
            <div class="bg-gray-100 border border-gray-300 rounded-lg p-4 space-y-1">
              <p class="text-xs text-gray-600">Group Size</p>
              <p class="text-lg font-bold text-gray-800">Self-guided</p>
            </div>
          </section>

          <!-- Itinerary -->
          <section class="space-y-6">
            <h2 class="text-2xl font-bold text-gray-800">Day-by-Day Itinerary</h2>

            <!-- Day 1 -->
            <div class="bg-gray-50 border border-gray-300 rounded-lg p-6 space-y-3">
              <div class="flex items-start justify-between gap-4">
                <div class="space-y-1">
                  <span class="text-xs font-semibold text-primary-600 uppercase">Day 1</span>
                  <h3 class="text-lg font-semibold text-gray-800">Arrive in San Gimignano</h3>
                </div>
                <div class="bg-gray-200 border border-gray-400 rounded px-3 py-1 text-xs text-gray-600">
                  No walking
                </div>
              </div>
              <p class="text-sm text-gray-600">
                Arrive in the medieval hilltop town of San Gimignano, known as the 'Manhattan of Tuscany' for its tower houses. Check into your hotel and explore the historic center at leisure.
              </p>
              <div class="flex gap-2 text-xs text-gray-600">
                <span>🏨 Hotel: San Gimignano Center</span>
              </div>
            </div>

            <!-- Day 2 -->
            <div class="bg-gray-50 border border-gray-300 rounded-lg p-6 space-y-3">
              <div class="flex items-start justify-between gap-4">
                <div class="space-y-1">
                  <span class="text-xs font-semibold text-primary-600 uppercase">Day 2</span>
                  <h3 class="text-lg font-semibold text-gray-800">San Gimignano to Colle di Val d'Elsa</h3>
                </div>
                <div class="bg-gray-200 border border-gray-400 rounded px-3 py-1 text-xs text-gray-600">
                  12km · 4-5 hours
                </div>
              </div>
              <p class="text-sm text-gray-600">
                Walk through rolling vineyards and olive groves to reach Colle di Val d'Elsa, a charming town divided into upper and lower sections. The route offers stunning views of the Tuscan countryside.
              </p>
              <div class="flex gap-2 text-xs text-gray-600">
                <span>🏨 Hotel: Colle Alta</span>
                <span>·</span>
                <span>🍽️ Breakfast included</span>
              </div>
            </div>

            <!-- Day 3 -->
            <div class="bg-gray-50 border border-gray-300 rounded-lg p-6 space-y-3">
              <div class="flex items-start justify-between gap-4">
                <div class="space-y-1">
                  <span class="text-xs font-semibold text-primary-600 uppercase">Day 3</span>
                  <h3 class="text-lg font-semibold text-gray-800">Colle di Val d'Elsa to Monteriggioni</h3>
                </div>
                <div class="bg-gray-200 border border-gray-400 rounded px-3 py-1 text-xs text-gray-600">
                  14km · 5 hours
                </div>
              </div>
              <p class="text-sm text-gray-600">
                Today's walk takes you through the Via Francigena pilgrimage route to the perfectly preserved medieval walled village of Monteriggioni, featured in Dante's Inferno.
              </p>
              <div class="flex gap-2 text-xs text-gray-600">
                <span>🏨 Hotel: Monteriggioni Castle View</span>
                <span>·</span>
                <span>🍽️ Breakfast & dinner included</span>
              </div>
            </div>

            <!-- Collapsed Days Indicator -->
            <button class="w-full bg-gray-100 border border-gray-300 rounded-lg p-4 text-sm text-gray-700 font-semibold hover:bg-gray-200">
              + Show Days 4-7
            </button>
          </section>

          <!-- What's Included -->
          <section class="space-y-4">
            <h2 class="text-2xl font-bold text-gray-800">What's Included</h2>
            <div class="grid grid-cols-1 @md:grid-cols-2 gap-6">
              <div class="space-y-3">
                <p class="text-sm font-semibold text-gray-800">✓ Included</p>
                <ul class="space-y-2 text-sm text-gray-600">
                  <li class="flex items-start gap-2">
                    <span class="text-primary-600">✓</span>
                    <span>6 nights accommodation in hand-picked hotels</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-primary-600">✓</span>
                    <span>Daily breakfast</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-primary-600">✓</span>
                    <span>GPS navigation app & detailed route notes</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-primary-600">✓</span>
                    <span>Luggage transfers between hotels</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-primary-600">✓</span>
                    <span>24/7 local support</span>
                  </li>
                </ul>
              </div>
              <div class="space-y-3">
                <p class="text-sm font-semibold text-gray-800">✕ Not Included</p>
                <ul class="space-y-2 text-sm text-gray-600">
                  <li class="flex items-start gap-2">
                    <span class="text-gray-400">✕</span>
                    <span>Flights or travel to start point</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-gray-400">✕</span>
                    <span>Lunches and most dinners</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-gray-400">✕</span>
                    <span>Travel insurance</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-gray-400">✕</span>
                    <span>Personal expenses</span>
                  </li>
                </ul>
              </div>
            </div>
          </section>

          <!-- Accommodation -->
          <section class="space-y-4">
            <h2 class="text-2xl font-bold text-gray-800">Accommodation</h2>
            <p class="text-base text-gray-600">
              We've carefully selected charming 3-star hotels in historic town centers, each offering authentic Italian hospitality, comfortable rooms, and local cuisine. All hotels feature en-suite bathrooms, Wi-Fi, and traditional Tuscan character.
            </p>
            <div class="grid grid-cols-2 @md:grid-cols-3 gap-3">
              <div class="bg-gray-200 border border-gray-400 rounded h-32 flex items-center justify-center text-xs text-gray-500">
                [ Hotel Image 1 ]
              </div>
              <div class="bg-gray-200 border border-gray-400 rounded h-32 flex items-center justify-center text-xs text-gray-500">
                [ Hotel Image 2 ]
              </div>
              <div class="bg-gray-200 border border-gray-400 rounded h-32 flex items-center justify-center text-xs text-gray-500">
                [ Hotel Image 3 ]
              </div>
            </div>
          </section>

          <!-- Reviews -->
          <section class="space-y-6">
            <div class="flex items-center justify-between">
              <h2 class="text-2xl font-bold text-gray-800">Guest Reviews</h2>
              <div class="flex items-center gap-2">
                <span class="text-accent-500 text-xl">★</span>
                <span class="text-2xl font-bold text-gray-800">4.8</span>
                <span class="text-sm text-gray-600">(127 reviews)</span>
              </div>
            </div>

            <!-- Review 1 -->
            <div class="bg-gray-50 border border-gray-300 rounded-lg p-6 space-y-3">
              <div class="flex items-start justify-between gap-4">
                <div class="space-y-1">
                  <div class="flex items-center gap-2">
                    <span class="text-sm font-semibold text-gray-800">Sarah M.</span>
                    <span class="text-xs text-gray-500">·</span>
                    <span class="text-xs text-gray-500">London, UK</span>
                  </div>
                  <div class="text-accent-500 text-sm">★★★★★</div>
                </div>
                <span class="text-xs text-gray-500">2 weeks ago</span>
              </div>
              <p class="text-sm text-gray-700">
                "Outstanding organization and attention to detail. The route notes were perfect, hotels were charming, and the Tuscan countryside exceeded our expectations. Headwater made our anniversary trip truly special."
              </p>
            </div>

            <!-- Review 2 -->
            <div class="bg-gray-50 border border-gray-300 rounded-lg p-6 space-y-3">
              <div class="flex items-start justify-between gap-4">
                <div class="space-y-1">
                  <div class="flex items-center gap-2">
                    <span class="text-sm font-semibold text-gray-800">James P.</span>
                    <span class="text-xs text-gray-500">·</span>
                    <span class="text-xs text-gray-500">Manchester, UK</span>
                  </div>
                  <div class="text-accent-500 text-sm">★★★★★</div>
                </div>
                <span class="text-xs text-gray-500">1 month ago</span>
              </div>
              <p class="text-sm text-gray-700">
                "Perfect balance of walking and free time. The GPS app was incredibly helpful, and luggage transfers meant we only carried a daypack. Food and wine were exceptional throughout."
              </p>
            </div>

            <button class="w-full bg-gray-100 border border-gray-300 rounded-lg p-3 text-sm text-gray-700 font-semibold hover:bg-gray-200">
              View All 127 Reviews
            </button>
          </section>

          <!-- FAQs -->
          <section class="space-y-4">
            <h2 class="text-2xl font-bold text-gray-800">Frequently Asked Questions</h2>

            <div class="space-y-3">
              <div class="bg-gray-50 border border-gray-300 rounded-lg p-5">
                <button class="w-full flex items-center justify-between text-left">
                  <span class="text-sm font-semibold text-gray-800">What fitness level do I need?</span>
                  <span class="text-gray-500">▼</span>
                </button>
              </div>

              <div class="bg-gray-50 border border-gray-300 rounded-lg p-5">
                <button class="w-full flex items-center justify-between text-left">
                  <span class="text-sm font-semibold text-gray-800">When is the best time to go?</span>
                  <span class="text-gray-500">▼</span>
                </button>
              </div>

              <div class="bg-gray-50 border border-gray-300 rounded-lg p-5">
                <button class="w-full flex items-center justify-between text-left">
                  <span class="text-sm font-semibold text-gray-800">Can I extend my stay?</span>
                  <span class="text-gray-500">▼</span>
                </button>
              </div>
            </div>
          </section>

          <!-- Similar Trips -->
          <section class="space-y-6">
            <h2 class="text-2xl font-bold text-gray-800">Similar Holidays</h2>

            <div class="grid grid-cols-1 @md:grid-cols-3 gap-6">
              <!-- Similar Trip 1 -->
              <div class="bg-gray-100 border border-gray-300 rounded-lg overflow-hidden">
                <div class="bg-gray-300 border-b border-gray-400 h-40 flex items-center justify-center text-gray-500 text-xs">
                  [ Trip Image ]
                </div>
                <div class="p-4 space-y-2">
                  <p class="text-sm font-semibold text-gray-800">Dolomites Trek</p>
                  <p class="text-xs text-gray-600">Italy · 6 days · Challenging</p>
                  <div class="flex items-center justify-between pt-2">
                    <span class="text-sm font-bold text-gray-800">from £1,495</span>
                    <span class="text-xs text-gray-600">★ 4.7</span>
                  </div>
                </div>
              </div>

              <!-- Similar Trip 2 -->
              <div class="bg-gray-100 border border-gray-300 rounded-lg overflow-hidden">
                <div class="bg-gray-300 border-b border-gray-400 h-40 flex items-center justify-center text-gray-500 text-xs">
                  [ Trip Image ]
                </div>
                <div class="p-4 space-y-2">
                  <p class="text-sm font-semibold text-gray-800">Amalfi Coast Walk</p>
                  <p class="text-xs text-gray-600">Italy · 7 days · Moderate</p>
                  <div class="flex items-center justify-between pt-2">
                    <span class="text-sm font-bold text-gray-800">from £1,345</span>
                    <span class="text-xs text-gray-600">★ 4.9</span>
                  </div>
                </div>
              </div>

              <!-- Similar Trip 3 -->
              <div class="bg-gray-100 border border-gray-300 rounded-lg overflow-hidden">
                <div class="bg-gray-300 border-b border-gray-400 h-40 flex items-center justify-center text-gray-500 text-xs">
                  [ Trip Image ]
                </div>
                <div class="p-4 space-y-2">
                  <p class="text-sm font-semibold text-gray-800">Cinque Terre Walking</p>
                  <p class="text-xs text-gray-600">Italy · 5 days · Easy</p>
                  <div class="flex items-center justify-between pt-2">
                    <span class="text-sm font-bold text-gray-800">from £995</span>
                    <span class="text-xs text-gray-600">★ 4.8</span>
                  </div>
                </div>
              </div>
            </div>
          </section>

        </main>

        <!-- Sticky Booking Sidebar -->
        <aside class="space-y-6">
          <div class="bg-gray-50 border-2 border-gray-300 rounded-lg p-6 space-y-6 sticky top-6">

            <!-- Price -->
            <div class="space-y-2">
              <div class="flex items-baseline gap-2">
                <span class="text-3xl font-bold text-gray-800">£1,245</span>
                <span class="text-sm text-gray-600">per person</span>
              </div>
              <p class="text-xs text-gray-600">Based on 2 people sharing</p>
            </div>

            <!-- Date Selector -->
            <div class="space-y-3">
              <label class="text-sm font-semibold text-gray-700">Select dates</label>
              <div class="bg-white border border-gray-300 rounded p-3 flex items-center justify-between cursor-pointer">
                <span class="text-sm text-gray-700">Choose departure date</span>
                <span class="text-gray-500">📅</span>
              </div>
            </div>

            <!-- Guests -->
            <div class="space-y-3">
              <label class="text-sm font-semibold text-gray-700">Number of guests</label>
              <div class="bg-white border border-gray-300 rounded p-3 flex items-center justify-between">
                <button class="bg-gray-100 border border-gray-300 rounded w-8 h-8 flex items-center justify-center text-gray-700">−</button>
                <span class="text-sm font-semibold text-gray-800">2 guests</span>
                <button class="bg-gray-100 border border-gray-300 rounded w-8 h-8 flex items-center justify-center text-gray-700">+</button>
              </div>
            </div>

            <!-- CTAs -->
            <div class="space-y-3">
              <button class="w-full bg-primary-500 text-white rounded-md px-6 py-3 text-sm font-semibold">
                Book Now
              </button>
              <button class="w-full bg-gray-100 border border-gray-400 rounded-md px-6 py-3 text-sm font-semibold text-gray-700">
                Request Callback
              </button>
            </div>

            <!-- Trust Signals -->
            <div class="pt-4 border-t border-gray-300 space-y-3">
              <div class="flex items-center gap-2 text-xs text-gray-600">
                <span>✓</span>
                <span>ABTA & ATOL protected</span>
              </div>
              <div class="flex items-center gap-2 text-xs text-gray-600">
                <span>✓</span>
                <span>Free cancellation up to 60 days</span>
              </div>
              <div class="flex items-center gap-2 text-xs text-gray-600">
                <span>✓</span>
                <span>Expert support 7 days a week</span>
              </div>
            </div>

            <!-- Contact -->
            <div class="pt-4 border-t border-gray-300 space-y-2">
              <p class="text-xs font-semibold text-gray-700">Need help deciding?</p>
              <div class="flex items-center gap-2 text-sm text-gray-700">
                <span>📞</span>
                <span class="font-semibold">01606 720199</span>
              </div>
              <p class="text-xs text-gray-600">We're open until 7pm today</p>
            </div>

          </div>

          <!-- Download Brochure -->
          <div class="bg-gray-100 border border-gray-300 rounded-lg p-5 space-y-3">
            <p class="text-sm font-semibold text-gray-700">Trip Brochure</p>
            <p class="text-xs text-gray-600">Download detailed information about this holiday</p>
            <button class="w-full bg-gray-200 border border-gray-400 rounded px-4 py-2 text-xs font-semibold text-gray-700">
              📄 Download PDF
            </button>
          </div>
        </aside>

      </div>

      <!-- Footer -->
      <div class="bg-gray-100 border border-gray-300 rounded-lg p-8">
        <div class="grid grid-cols-2 @md:grid-cols-4 gap-6 mb-6">
          <div class="space-y-2">
            <p class="text-base font-bold text-gray-800">Headwater</p>
            <p class="text-xs text-gray-600">Est. 1985</p>
            <div class="flex gap-2 text-xs text-gray-500">
              <span>ABTA</span>
              <span>ATOL</span>
            </div>
          </div>
          <div class="space-y-2">
            <p class="text-sm font-semibold text-gray-700">Destinations</p>
            <div class="space-y-1 text-xs text-gray-600">
              <p>Walking</p>
              <p>Cycling</p>
              <p>Multi-Activity</p>
              <p>View All</p>
            </div>
          </div>
          <div class="space-y-2">
            <p class="text-sm font-semibold text-gray-700">About</p>
            <div class="space-y-1 text-xs text-gray-600">
              <p>Our Story</p>
              <p>Team</p>
              <p>Reviews</p>
              <p>Press</p>
            </div>
          </div>
          <div class="space-y-2">
            <p class="text-sm font-semibold text-gray-700">Contact</p>
            <div class="space-y-1 text-xs text-gray-600">
              <p>01606 720199</p>
              <p>sales@headwater.com</p>
              <p>Brochure</p>
              <p>FAQ</p>
            </div>
          </div>
        </div>
        <div class="border-t border-gray-300 pt-4 text-center text-xs text-gray-500">
          © 2026 Headwater Holidays Ltd
        </div>
      </div>

    </div>
  </div>
</GalleryLayout>
