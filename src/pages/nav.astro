---
import GalleryLayout from '../layouts/GalleryLayout.astro';
import Nav from '../components/Nav.astro';
---

<GalleryLayout title="Navigation" description="Top navigation bar with logo, links, CTA, and mobile menu. Two variants: light (white background) and transparent (for overlaying hero images). Mobile menu via mobileOpen prop." fullscreenHref="/view/nav">

  <!-- Light variant (default) -->
  <section class="specimen-section">
    <h2>Light Variant</h2>
    <p class="text-sm text-gray-600 mb-6 max-w-[65ch]">
      Default navigation on white background with warm shadow. Forest green CTA, gray-600 links that darken on hover. Use on pages where the nav sits above light content.
    </p>
    <div class="border border-gray-200 rounded-lg overflow-hidden">
      <div class="@container">
        <Nav />
      </div>
    </div>
  </section>

  <!-- Transparent variant -->
  <section class="specimen-section">
    <h2>Transparent Variant</h2>
    <p class="text-sm text-gray-600 mb-6 max-w-[65ch]">
      For overlaying hero images or dark backgrounds. White text, white CTA with primary text color. Links use white/80 opacity that goes solid on hover.
    </p>
    <div class="border border-gray-200 rounded-lg overflow-hidden">
      <div class="@container relative">
        <img
          src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=1200&h=400&fit=crop"
          alt="Mountain landscape"
          class="absolute inset-0 w-full h-full object-cover"
        />
        <div class="relative">
          <Nav variant="transparent" />
        </div>
      </div>
    </div>
  </section>

  <!-- Transparent on dark solid -->
  <section class="specimen-section">
    <h2>Transparent on Solid Dark</h2>
    <p class="text-sm text-gray-600 mb-6 max-w-[65ch]">
      The transparent variant also works on solid dark backgrounds — hero sections with color fills, pre-header bars, etc.
    </p>
    <div class="border border-gray-200 rounded-lg overflow-hidden">
      <div class="@container bg-gray-900">
        <Nav variant="transparent" />
      </div>
    </div>
    <div class="border border-gray-200 rounded-lg overflow-hidden mt-6">
      <div class="@container bg-primary-700">
        <Nav variant="transparent" />
      </div>
    </div>
  </section>

  <!-- Mobile: closed state -->
  <section class="specimen-section">
    <h2>Mobile — Closed</h2>
    <p class="text-sm text-gray-600 mb-6 max-w-[65ch]">
      At narrow container widths (&lt;1024px), links collapse behind a hamburger button. The CTA hides from the top bar and moves into the mobile menu.
    </p>
    <div class="border border-gray-200 rounded-lg overflow-hidden">
      <div class="@container max-w-sm mx-auto">
        <Nav />
      </div>
    </div>
  </section>

  <!-- Mobile: open state (light) -->
  <section class="specimen-section">
    <h2>Mobile — Open (Light)</h2>
    <p class="text-sm text-gray-600 mb-6 max-w-[65ch]">
      The <code class="text-xs bg-gray-100 px-1.5 py-0.5 rounded-sm font-mono">mobileOpen</code> prop shows the expanded mobile menu. Links stack vertically with generous tap targets (py-3). CTA appears at the bottom separated by a border.
    </p>
    <div class="border border-gray-200 rounded-lg overflow-hidden">
      <div class="@container max-w-sm mx-auto">
        <Nav mobileOpen />
      </div>
    </div>
  </section>

  <!-- Mobile: open state (transparent) -->
  <section class="specimen-section">
    <h2>Mobile — Open (Transparent)</h2>
    <p class="text-sm text-gray-600 mb-6 max-w-[65ch]">
      Transparent variant mobile menu uses a dark background to maintain contrast. Links use white/80 with white hover states.
    </p>
    <div class="border border-gray-200 rounded-lg overflow-hidden">
      <div class="@container max-w-sm mx-auto">
        <div class="bg-gray-900">
          <Nav variant="transparent" mobileOpen />
        </div>
      </div>
    </div>
  </section>

  <!-- Responsive behavior -->
  <section class="specimen-section">
    <h2>Responsive Behavior</h2>
    <p class="text-sm text-gray-600 mb-6 max-w-[65ch]">
      The nav uses <code class="text-xs bg-gray-100 px-1.5 py-0.5 rounded-sm font-mono">@lg:</code> container query (1024px). Below that threshold, links and CTA collapse. Above it, they expand inline. Resize your browser or compare the containers below.
    </p>

    <h3 class="text-sm font-semibold text-gray-600 uppercase tracking-wide mb-4">Narrow (~320px)</h3>
    <div class="border border-gray-200 rounded-lg overflow-hidden mb-6">
      <div class="@container" style="max-width: 320px; margin: 0 auto;">
        <Nav />
      </div>
    </div>

    <h3 class="text-sm font-semibold text-gray-600 uppercase tracking-wide mb-4">Medium (~768px)</h3>
    <div class="border border-gray-200 rounded-lg overflow-hidden mb-6">
      <div class="@container" style="max-width: 768px; margin: 0 auto;">
        <Nav />
      </div>
    </div>

    <h3 class="text-sm font-semibold text-gray-600 uppercase tracking-wide mb-4">Wide (~1280px)</h3>
    <div class="border border-gray-200 rounded-lg overflow-hidden">
      <div class="@container" style="max-width: 1280px;">
        <Nav />
      </div>
    </div>
  </section>

  <!-- Anatomy -->
  <section class="specimen-section">
    <h2>Anatomy</h2>
    <p class="text-sm text-gray-600 mb-6 max-w-[65ch]">
      Props and class construction breakdown.
    </p>
    <div class="border border-gray-200 rounded-lg overflow-hidden">
      <div class="p-6">
        <div class="flex flex-col gap-3 text-sm">
          <div class="flex gap-3 items-start">
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide w-24 shrink-0 pt-0.5">Container</span>
            <code class="text-xs bg-gray-100 px-2 py-1 rounded-sm font-mono text-gray-700 leading-relaxed">@container — triggers @lg: breakpoint at 1024px</code>
          </div>
          <div class="flex gap-3 items-start">
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide w-24 shrink-0 pt-0.5">Height</span>
            <code class="text-xs bg-gray-100 px-2 py-1 rounded-sm font-mono text-gray-700 leading-relaxed">h-16 (64px)</code>
          </div>
          <div class="flex gap-3 items-start">
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide w-24 shrink-0 pt-0.5">Layout</span>
            <code class="text-xs bg-gray-100 px-2 py-1 rounded-sm font-mono text-gray-700 leading-relaxed">flex items-center justify-between, max-w-[var(--container-max)]</code>
          </div>
          <div class="flex gap-3 items-start">
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide w-24 shrink-0 pt-0.5">Logo</span>
            <code class="text-xs bg-gray-100 px-2 py-1 rounded-sm font-mono text-gray-700 leading-relaxed">text-xl font-bold tracking-tight</code>
          </div>
          <div class="flex gap-3 items-start">
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide w-24 shrink-0 pt-0.5">Links</span>
            <code class="text-xs bg-gray-100 px-2 py-1 rounded-sm font-mono text-gray-700 leading-relaxed">text-sm font-semibold, gap-8, hidden @lg:flex</code>
          </div>
          <div class="flex gap-3 items-start">
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide w-24 shrink-0 pt-0.5">CTA</span>
            <code class="text-xs bg-gray-100 px-2 py-1 rounded-sm font-mono text-gray-700 leading-relaxed">Button sm — hidden @lg:inline-flex</code>
          </div>
          <div class="flex gap-3 items-start">
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide w-24 shrink-0 pt-0.5">Hamburger</span>
            <code class="text-xs bg-gray-100 px-2 py-1 rounded-sm font-mono text-gray-700 leading-relaxed">@lg:hidden, p-3 (44px tap target with 20px icon)</code>
          </div>
          <div class="flex gap-3 items-start">
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide w-24 shrink-0 pt-0.5">Mobile links</span>
            <code class="text-xs bg-gray-100 px-2 py-1 rounded-sm font-mono text-gray-700 leading-relaxed">py-3 px-3 — stacked, full-width tap targets</code>
          </div>
          <div class="flex gap-3 items-start">
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide w-24 shrink-0 pt-0.5">Variant</span>
            <code class="text-xs bg-gray-100 px-2 py-1 rounded-sm font-mono text-gray-700 leading-relaxed">"light" (default) | "transparent"</code>
          </div>
          <div class="flex gap-3 items-start">
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide w-24 shrink-0 pt-0.5">mobileOpen</span>
            <code class="text-xs bg-gray-100 px-2 py-1 rounded-sm font-mono text-gray-700 leading-relaxed">boolean — shows expanded mobile menu (engineering wires toggle)</code>
          </div>
        </div>
      </div>
    </div>
  </section>

</GalleryLayout>
