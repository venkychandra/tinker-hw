---
import GalleryLayout from '../layouts/GalleryLayout.astro';
import FAQ from '../components/FAQ.astro';

const faqs = [
  {
    question: "What fitness level do I need for a walking tour?",
    answer: "Our walking tours are graded from gentle to challenging. Gentle tours average 3-5 miles per day on mostly flat terrain. Moderate tours cover 5-8 miles with some hills. Challenging tours involve 8+ miles daily with significant elevation changes. Each tour listing includes a detailed fitness guide to help you choose the right level."
  },
  {
    question: "What's included in the tour price?",
    answer: "All tours include accommodation, daily breakfast, detailed route notes, GPS navigation files, and luggage transfers between hotels. Many tours also include some evening meals. International flights, travel insurance, and personal expenses are not included. Check each tour's 'What's Included' section for specifics."
  },
  {
    question: "How do I get to the starting point?",
    answer: "Each tour provides detailed travel instructions including recommended airports, train stations, and transfer options. Most tours start in towns with good public transport links. We can arrange airport transfers for an additional fee if you prefer door-to-door service."
  },
  {
    question: "Can I extend my trip or add rest days?",
    answer: "Yes, most tours can be customized with additional nights at the start, middle, or end of your journey. Contact us at least 8 weeks before departure to arrange extensions. Some popular locations may have limited availability during peak season."
  },
  {
    question: "What happens if the weather is bad?",
    answer: "Walking tours operate rain or shine—we provide weatherproof route notes and our local teams monitor conditions. Accommodation and luggage transfers are guaranteed regardless of weather. We recommend packing layers and waterproofs. If severe weather makes routes unsafe, we'll provide alternative suggestions or transport to the next stop."
  },
  {
    question: "Do you offer single traveler options?",
    answer: "Yes, solo travelers are welcome on all tours. Single room supplements apply to guarantee your own room. Some tours offer 'willing to share' options where we'll match you with another solo traveler of the same gender to avoid the supplement, subject to availability."
  }
];
---

<GalleryLayout title="FAQ" fullscreenHref="/view/faq">
  <div class="@container">
    <!-- Default State -->
    <section class="mb-16">
      <h2 class="gallery-label">Default</h2>
      <div class="gallery-specimen">
        <div class="max-w-3xl mx-auto">
          <FAQ
            question="What fitness level do I need for a walking tour?"
            answer="Our walking tours are graded from gentle to challenging. Gentle tours average 3-5 miles per day on mostly flat terrain. Moderate tours cover 5-8 miles with some hills. Challenging tours involve 8+ miles daily with significant elevation changes. Each tour listing includes a detailed fitness guide to help you choose the right level."
          />
        </div>
      </div>
    </section>

    <!-- Open State -->
    <section class="mb-16">
      <h2 class="gallery-label">Open State</h2>
      <div class="gallery-specimen">
        <div class="max-w-3xl mx-auto">
          <details open class="group border-b border-gray-200 py-6 transition-colors duration-[var(--duration-normal)] hover:border-gray-300">
            <summary class="flex cursor-pointer items-start justify-between gap-6 text-left list-none select-none">
              <span class="text-lg font-semibold text-gray-900 leading-normal transition-colors duration-[var(--duration-normal)] group-hover:text-primary-700">
                What's included in the tour price?
              </span>
              <svg
                class="shrink-0 w-6 h-6 text-accent-500 transition-transform duration-[var(--duration-normal)] group-open:rotate-180"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.5"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="pt-4 pr-12 text-base text-gray-600 leading-relaxed max-w-[75ch]">
              All tours include accommodation, daily breakfast, detailed route notes, GPS navigation files, and luggage transfers between hotels. Many tours also include some evening meals. International flights, travel insurance, and personal expenses are not included. Check each tour's 'What's Included' section for specifics.
            </div>
          </details>
        </div>
      </div>
    </section>

    <!-- Multiple FAQs -->
    <section class="mb-16">
      <h2 class="gallery-label">Multiple Items</h2>
      <div class="gallery-specimen">
        <div class="max-w-3xl mx-auto divide-y divide-gray-100">
          {faqs.map(faq => (
            <FAQ question={faq.question} answer={faq.answer} />
          ))}
        </div>
      </div>
    </section>

    <!-- Narrow Container (Mobile) -->
    <section class="mb-16">
      <h2 class="gallery-label">Narrow Container (~375px)</h2>
      <div class="gallery-specimen">
        <div class="max-w-[375px] mx-auto">
          <FAQ
            question="What fitness level do I need for a walking tour?"
            answer="Our walking tours are graded from gentle to challenging. Gentle tours average 3-5 miles per day on mostly flat terrain. Moderate tours cover 5-8 miles with some hills. Challenging tours involve 8+ miles daily with significant elevation changes."
          />
          <FAQ
            question="Can I extend my trip or add rest days?"
            answer="Yes, most tours can be customized with additional nights at the start, middle, or end of your journey. Contact us at least 8 weeks before departure to arrange extensions."
          />
        </div>
      </div>
    </section>
  </div>
</GalleryLayout>

<style>
  /* Remove default marker */
  summary::-webkit-details-marker {
    display: none;
  }
</style>
